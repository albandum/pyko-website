---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Documentation" description="Everything you need to get started and master Pyko.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">Pyko Documentation</h1>
        <p class="text-xl text-gray-700 mb-8">Everything you need to get started and master Pyko</p>
        <input type="text" placeholder="Search docs..." class="px-4 py-3 rounded-lg border border-gray-300 max-w-md w-full" />
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-6 bg-gray-50 rounded-xl">
          <h2 class="text-xl font-bold text-navy mb-4">🚀 Getting Started</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="text-accent hover:text-accent-dark">Quick Start Guide</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Connecting Your CRM</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Connecting Slack/Teams</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Creating Your First Automation</a></li>
          </ul>
        </div>

        <div class="p-6 bg-gray-50 rounded-xl">
          <h2 class="text-xl font-bold text-navy mb-4">📡 Live Alerts</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="text-accent hover:text-accent-dark">Creating Live Alerts</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Condition Builder Guide</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Message Customization</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Destination Routing</a></li>
          </ul>
        </div>

        <div class="p-6 bg-gray-50 rounded-xl">
          <h2 class="text-xl font-bold text-navy mb-4">✨ Cleaning Rules</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="text-accent hover:text-accent-dark">Creating Scheduled Rules</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Scheduling Options</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Common Use Cases</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Best Practices</a></li>
          </ul>
        </div>

        <div class="p-6 bg-gray-50 rounded-xl">
          <h2 class="text-xl font-bold text-navy mb-4">⚡ Actions</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="text-accent hover:text-accent-dark">Interactive Buttons</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Action Types</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Permissions & Security</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Audit Trail</a></li>
          </ul>
        </div>

        <div class="p-6 bg-gray-50 rounded-xl">
          <h2 class="text-xl font-bold text-navy mb-4">🔌 Integrations</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="/integrations/salesforce" class="text-accent hover:text-accent-dark">Salesforce Setup</a></li>
            <li><a href="/integrations/hubspot" class="text-accent hover:text-accent-dark">HubSpot Setup</a></li>
            <li><a href="/integrations/slack" class="text-accent hover:text-accent-dark">Slack Setup</a></li>
            <li><a href="/integrations/teams" class="text-accent hover:text-accent-dark">Teams Setup</a></li>
          </ul>
        </div>

        <div class="p-6 bg-gray-50 rounded-xl">
          <h2 class="text-xl font-bold text-navy mb-4">📊 Analytics</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="text-accent hover:text-accent-dark">Understanding Run History</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Action Tracking</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Engagement Metrics</a></li>
            <li><a href="#" class="text-accent hover:text-accent-dark">Exporting Data</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
