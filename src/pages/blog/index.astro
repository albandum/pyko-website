---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Pyko Blog - Revenue Radar Insights" description="Sales automation tips, CRM best practices, and product updates.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">Revenue Radar Insights</h1>
        <p class="text-xl text-gray-700 mb-8">Sales automation tips, CRM best practices, and product updates.</p>
        <form class="flex gap-2 max-w-md mx-auto">
          <input type="email" placeholder="Your email" class="flex-1 px-4 py-3 rounded-lg border border-gray-300" />
          <button class="px-6 py-3 bg-accent text-white rounded-lg font-semibold hover:bg-accent-dark">Subscribe</button>
        </form>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { title: "How to Set Up Salesforce Alerts in Slack", category: "How-To", date: "Nov 15, 2025" },
          { title: "10 HubSpot Automations Every Sales Team Needs", category: "How-To", date: "Nov 12, 2025" },
          { title: "The Complete Guide to CRM Data Hygiene", category: "Best Practices", date: "Nov 8, 2025" },
          { title: "Why Your Sales Team Ignores CRM", category: "Industry Insights", date: "Nov 5, 2025" },
          { title: "7 CRM Alerts That Actually Improve Performance", category: "Best Practices", date: "Nov 1, 2025" },
          { title: "Revenue Orchestration Platforms Compared", category: "Comparisons", date: "Oct 28, 2025" },
        ].map(post => (
          <article class="bg-gray-50 rounded-xl overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-48 bg-gradient-to-br from-accent to-purple-600"></div>
            <div class="p-6">
              <div class="text-xs text-accent font-semibold mb-2">{post.category}</div>
              <h2 class="text-xl font-bold text-navy mb-2 line-clamp-2">{post.title}</h2>
              <div class="text-sm text-gray-500 mb-4">{post.date}</div>
              <a href="#" class="text-accent hover:text-accent-dark font-semibold text-sm">Read more →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
