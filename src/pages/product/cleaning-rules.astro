---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout
  title="Cleaning Rules - Automated CRM Data Hygiene"
  description="Schedule automated data quality checks that run daily, weekly, or monthly. Catch stale data and missing fields before they hurt your forecast."
>
  <!-- Hero Section -->
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-navy mb-6">
          Automated CRM hygiene while you sleep
        </h1>
        <p class="text-xl md:text-2xl text-gray-700 mb-8">
          Schedule automated data quality checks that run daily, weekly, or monthly. Catch stale data, missing fields, and process violations before they hurt your forecast.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/trial" variant="primary" size="lg">
            Start Free Trial
          </Button>
          <Button href="/templates" variant="outline" size="lg">
            View Cleaning Templates
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Scheduled vs Real-Time -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">
          Scheduled vs. Real-Time: When to use each
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="p-8 bg-accent/5 rounded-xl border-2 border-accent">
          <h3 class="text-2xl font-bold text-navy mb-4">📡 Live Alerts</h3>
          <p class="text-gray-700 mb-4">Trigger <strong>immediately</strong> when something happens</p>
          <ul class="space-y-2 text-gray-700">
            <li>✓ New lead created</li>
            <li>✓ Deal stage changes</li>
            <li>✓ Opportunity won/lost</li>
            <li>✓ High-value record created</li>
          </ul>
          <div class="mt-6 p-4 bg-white rounded-lg border border-accent">
            <div class="text-sm font-semibold text-navy mb-2">Best for:</div>
            <div class="text-sm text-gray-600">Time-sensitive events requiring immediate action</div>
          </div>
        </div>

        <div class="p-8 bg-success/5 rounded-xl border-2 border-success">
          <h3 class="text-2xl font-bold text-navy mb-4">✨ Cleaning Rules</h3>
          <p class="text-gray-700 mb-4">Run <strong>on a schedule</strong> to find existing problems</p>
          <ul class="space-y-2 text-gray-700">
            <li>✓ Stale close dates</li>
            <li>✓ Missing required fields</li>
            <li>✓ Records needing follow-up</li>
            <li>✓ Weekly/monthly audits</li>
          </ul>
          <div class="mt-6 p-4 bg-white rounded-lg border border-success">
            <div class="text-sm font-semibold text-navy mb-2">Best for:</div>
            <div class="text-sm text-gray-600">Proactive data hygiene and maintenance</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Scheduling Options -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">
          Run on your team's schedule
        </h2>
        <p class="text-lg text-gray-600">
          Flexible scheduling options to fit your workflow
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="p-6 bg-white rounded-xl border border-gray-200">
          <h3 class="text-xl font-bold text-navy mb-3">📅 Daily</h3>
          <p class="text-gray-700 text-sm mb-4">Run every day at a specific time</p>
          <div class="text-xs text-gray-600 bg-gray-50 p-3 rounded">
            <strong>Example:</strong> Every day at 9:00 AM EST, find all opportunities with close dates in the past
          </div>
        </div>

        <div class="p-6 bg-white rounded-xl border border-gray-200">
          <h3 class="text-xl font-bold text-navy mb-3">📆 Weekly</h3>
          <p class="text-gray-700 text-sm mb-4">Specific days of the week</p>
          <div class="text-xs text-gray-600 bg-gray-50 p-3 rounded">
            <strong>Example:</strong> Every Monday and Thursday at 10:00 AM, check for missing next steps
          </div>
        </div>

        <div class="p-6 bg-white rounded-xl border border-gray-200">
          <h3 class="text-xl font-bold text-navy mb-3">📊 Monthly</h3>
          <p class="text-gray-700 text-sm mb-4">First or last day of month</p>
          <div class="text-xs text-gray-600 bg-gray-50 p-3 rounded">
            <strong>Example:</strong> First of every month, find accounts with contracts expiring in 60-90 days
          </div>
        </div>
      </div>

      <div class="mt-12 max-w-3xl mx-auto p-6 bg-white rounded-xl border-2 border-gray-200">
        <h4 class="font-bold text-navy mb-4">Advanced Options:</h4>
        <div class="grid md:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="font-semibold text-accent">⏰ Timezone Support</span>
            <p class="text-gray-600">Run in your team's timezone</p>
          </div>
          <div>
            <span class="font-semibold text-accent">🗓️ Schedule Cancel Date</span>
            <p class="text-gray-600">Auto-deactivate after a certain date</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Common Data Quality Issues -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">
          Fix these problems automatically
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 bg-red-50 rounded-xl border-2 border-red-200">
          <div class="text-3xl mb-3">📅</div>
          <h3 class="text-xl font-bold text-navy mb-2">Stale Close Dates</h3>
          <p class="text-gray-700 mb-3">Opportunities with close dates in the past but still open</p>
          <div class="text-sm font-semibold text-red-700 bg-white p-3 rounded">
            <strong>Impact:</strong> Pollutes your forecast, makes reports unreliable
          </div>
        </div>

        <div class="p-6 bg-orange-50 rounded-xl border-2 border-orange-200">
          <div class="text-3xl mb-3">📝</div>
          <h3 class="text-xl font-bold text-navy mb-2">Missing Required Fields</h3>
          <p class="text-gray-700 mb-3">Records missing Next Steps, Contact Role, or other key fields</p>
          <div class="text-sm font-semibold text-orange-700 bg-white p-3 rounded">
            <strong>Impact:</strong> Incomplete data leads to poor decision-making
          </div>
        </div>

        <div class="p-6 bg-yellow-50 rounded-xl border-2 border-yellow-200">
          <div class="text-3xl mb-3">👤</div>
          <h3 class="text-xl font-bold text-navy mb-2">Inactive Owners</h3>
          <p class="text-gray-700 mb-3">Records assigned to users who left the company</p>
          <div class="text-sm font-semibold text-yellow-700 bg-white p-3 rounded">
            <strong>Impact:</strong> Leads and deals fall through cracks
          </div>
        </div>

        <div class="p-6 bg-purple-50 rounded-xl border-2 border-purple-200">
          <div class="text-3xl mb-3">🔄</div>
          <h3 class="text-xl font-bold text-navy mb-2">Duplicate Records</h3>
          <p class="text-gray-700 mb-3">Multiple contacts or accounts for the same entity</p>
          <div class="text-sm font-semibold text-purple-700 bg-white p-3 rounded">
            <strong>Impact:</strong> Confusion, wasted effort, bad customer experience
          </div>
        </div>

        <div class="p-6 bg-gray-100 rounded-xl border-2 border-gray-300">
          <div class="text-3xl mb-3">💤</div>
          <h3 class="text-xl font-bold text-navy mb-2">Outdated Information</h3>
          <p class="text-gray-700 mb-3">Last activity date >90 days ago, no recent engagement</p>
          <div class="text-sm font-semibold text-gray-700 bg-white p-3 rounded">
            <strong>Impact:</strong> Pipeline bloat, inaccurate forecasting
          </div>
        </div>

        <div class="p-6 bg-blue-50 rounded-xl border-2 border-blue-200">
          <div class="text-3xl mb-3">⚙️</div>
          <h3 class="text-xl font-bold text-navy mb-2">Process Violations</h3>
          <p class="text-gray-700 mb-3">Deals advancing stages without completing required tasks</p>
          <div class="text-sm font-semibold text-blue-700 bg-white p-3 rounded">
            <strong>Impact:</strong> Inconsistent sales process, lower win rates
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Examples -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">
          Real cleaning automation examples
        </h2>
      </div>

      <div class="space-y-6 max-w-4xl mx-auto">
        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-2xl flex-shrink-0">📅</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-navy mb-2">Stale Opportunities Cleanup</h3>
              <div class="grid md:grid-cols-3 gap-4 text-sm">
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Schedule</div>
                  <div class="text-gray-600">Every Monday at 9am</div>
                </div>
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Conditions</div>
                  <div class="text-gray-600">Open opportunities, close date in past</div>
                </div>
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Action</div>
                  <div class="text-gray-600">Alert owner to update</div>
                </div>
              </div>
              <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded text-sm">
                <strong class="text-green-700">Result:</strong> <span class="text-gray-700">Close date accuracy improved from 60% to 90%</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center text-2xl flex-shrink-0">📝</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-navy mb-2">Missing Next Steps Enforcement</h3>
              <div class="grid md:grid-cols-3 gap-4 text-sm">
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Schedule</div>
                  <div class="text-gray-600">Every Friday at 3pm</div>
                </div>
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Conditions</div>
                  <div class="text-gray-600">Open opps assigned to me, Next Steps is empty</div>
                </div>
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Action</div>
                  <div class="text-gray-600">DM reminder + update button</div>
                </div>
              </div>
              <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded text-sm">
                <strong class="text-green-700">Result:</strong> <span class="text-gray-700">95% compliance with required fields</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center text-2xl flex-shrink-0">🔄</div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-navy mb-2">Renewal Pipeline Builder</h3>
              <div class="grid md:grid-cols-3 gap-4 text-sm">
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Schedule</div>
                  <div class="text-gray-600">First of every month</div>
                </div>
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Conditions</div>
                  <div class="text-gray-600">Accounts with contract end date in 60-90 days</div>
                </div>
                <div>
                  <div class="font-semibold text-gray-700 mb-1">Action</div>
                  <div class="text-gray-600">Alert CSM, create renewal opp</div>
                </div>
              </div>
              <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded text-sm">
                <strong class="text-green-700">Result:</strong> <span class="text-gray-700">Zero missed renewals</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Track Progress -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">
            See your data quality improve over time
          </h2>
          <p class="text-lg text-gray-600">
            Cleaning rules track how many records matched each run, so you can measure improvement
          </p>
        </div>

        <div class="bg-gradient-to-br from-accent/10 to-purple-50 rounded-xl p-8">
          <h3 class="text-xl font-bold text-navy mb-6">Example: Stale Opportunities Trend</h3>
          <div class="bg-white rounded-lg p-6">
            <div class="flex items-end gap-2 h-48">
              <div class="flex-1 bg-red-200 rounded-t" style="height: 90%;"><div class="text-center pt-2 text-sm font-semibold">45</div></div>
              <div class="flex-1 bg-red-200 rounded-t" style="height: 78%;"><div class="text-center pt-2 text-sm font-semibold">39</div></div>
              <div class="flex-1 bg-orange-200 rounded-t" style="height: 60%;"><div class="text-center pt-2 text-sm font-semibold">30</div></div>
              <div class="flex-1 bg-yellow-200 rounded-t" style="height: 42%;"><div class="text-center pt-2 text-sm font-semibold">21</div></div>
              <div class="flex-1 bg-green-200 rounded-t" style="height: 24%;"><div class="text-center pt-2 text-sm font-semibold">12</div></div>
              <div class="flex-1 bg-green-300 rounded-t" style="height: 16%;"><div class="text-center pt-2 text-sm font-semibold">8</div></div>
            </div>
            <div class="flex gap-2 mt-2 text-xs text-gray-600">
              <div class="flex-1 text-center">Week 1</div>
              <div class="flex-1 text-center">Week 2</div>
              <div class="flex-1 text-center">Week 3</div>
              <div class="flex-1 text-center">Week 4</div>
              <div class="flex-1 text-center">Week 5</div>
              <div class="flex-1 text-center">Week 6</div>
            </div>
          </div>
          <div class="mt-6 text-center">
            <div class="text-3xl font-bold text-success">↓ 82% reduction</div>
            <div class="text-gray-600 mt-2">in stale opportunities over 6 weeks</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Templates -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-6">
          Pre-built cleaning rule templates
        </h2>
        <p class="text-lg text-gray-700 mb-8">
          Deploy proven data hygiene workflows in one click
        </p>
        <Button href="/templates" variant="primary" size="lg">
          Browse Cleaning Templates
        </Button>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    headline="Ready to automate your CRM data hygiene?"
    subheadline="Set up your first cleaning rule in under 5 minutes. Watch your data quality improve."
    primaryCTA={{ text: "Start Free Trial", href: "/trial" }}
    secondaryCTA={{ text: "View Documentation", href: "/docs/cleaning-rules" }}
    variant="gradient"
  />
</MainLayout>
