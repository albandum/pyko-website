---
import MainLayout from '../layouts/MainLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<MainLayout title="About Pyko" description="We help sales teams work where they already are.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">We help sales teams work where they already are</h1>
        <p class="text-xl text-gray-700">Pyko was born from a simple insight: sales reps live in Slack, but their data lives in Salesforce. We built the bridge.</p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-navy mb-6">Our Mission</h2>
        <p class="text-lg text-gray-700 mb-8">Make CRM data accessible and actionable for every member of the revenue team - without forcing them to change how they work.</p>

        <h2 class="text-3xl font-bold text-navy mb-6 mt-12">Our Values</h2>
        <div class="space-y-6">
          <div>
            <h3 class="text-xl font-bold text-navy mb-2">Customer Obsession</h3>
            <p class="text-gray-700">We build what sales teams actually need, not what sounds impressive.</p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-navy mb-2">Simplicity</h3>
            <p class="text-gray-700">Complex problems deserve simple solutions.</p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-navy mb-2">Speed</h3>
            <p class="text-gray-700">In sales, minutes matter. We respect your time.</p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-navy mb-2">Transparency</h3>
            <p class="text-gray-700">Clear pricing, clear communication, clear impact.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection headline="Want to see what we're building?" primaryCTA={{ text: "Start Free Trial", href: "/trial" }} variant="gradient" />
</MainLayout>
