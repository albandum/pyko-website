---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout
  title="How to Get Salesforce Lead Notifications in Slack (2025 Guide)"
  description="Get instant Salesforce lead notifications in Slack. Compare native integration, Zapier, and Pyko. Real-time alerts in under 3 seconds with one-click actions."
>
  <!-- Hero Section -->
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="flex items-center justify-center gap-4 mb-6">
          <img src="/images/logos/salesforce.svg" alt="Salesforce" class="h-12 w-12" />
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          <img src="/images/logos/slack.svg" alt="Slack" class="h-12 w-12" />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
          How to Get Salesforce Lead Notifications in Slack
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
          Never miss a new lead again. Learn how to set up instant Salesforce notifications in Slack and respond to leads before your competitors.
        </p>
        <Button href="/trial" variant="primary" size="lg">
          Get Started Free
        </Button>
        <p class="text-sm text-gray-400 mt-4">Setup in under 5 minutes. No credit card required.</p>
      </div>
    </div>
  </section>

  <!-- Quick Answer Section -->
  <section class="py-12 bg-white border-b border-gray-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
          <h2 class="text-lg font-bold text-blue-900 mb-3">Quick Answer</h2>
          <p class="text-blue-800">
            There are 3 main ways to get Salesforce lead notifications in Slack: <strong>Native Salesforce for Slack</strong> (basic alerts), <strong>Zapier</strong> (polling-based), or <strong>Pyko</strong> (real-time with one-click actions). For instant notifications under 3 seconds, Pyko is the fastest option using Salesforce Platform Events.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-center" style="color: #061A35;">
          Compare Your Options
        </h2>
        <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
          Each method has trade-offs. Here's how they compare for sales teams.
        </p>

        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-gray-700">
            <thead>
              <tr class="bg-gray-50">
                <th class="text-left p-4 border border-gray-200 font-semibold" style="color: #061A35;">Feature</th>
                <th class="text-center p-4 border border-gray-200 font-semibold" style="color: #061A35;">Native Salesforce</th>
                <th class="text-center p-4 border border-gray-200 font-semibold" style="color: #061A35;">Zapier</th>
                <th class="text-center p-4 border border-gray-200 font-semibold" style="color: #F94730;">Pyko</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bg-white">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Alert Speed</td>
                <td class="p-4 border border-gray-200 text-center">1-5 minutes</td>
                <td class="p-4 border border-gray-200 text-center">1-15 minutes</td>
                <td class="p-4 border border-gray-200 text-center font-semibold" style="color: #F94730;">1-3 seconds</td>
              </tr>
              <tr class="bg-gray-50">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Setup Time</td>
                <td class="p-4 border border-gray-200 text-center">30+ minutes</td>
                <td class="p-4 border border-gray-200 text-center">10-15 minutes</td>
                <td class="p-4 border border-gray-200 text-center font-semibold" style="color: #F94730;">5 minutes</td>
              </tr>
              <tr class="bg-white">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">One-Click Actions</td>
                <td class="p-4 border border-gray-200 text-center">Limited</td>
                <td class="p-4 border border-gray-200 text-center">No</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes</td>
              </tr>
              <tr class="bg-gray-50">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Custom Routing</td>
                <td class="p-4 border border-gray-200 text-center">Complex (Flows)</td>
                <td class="p-4 border border-gray-200 text-center">Basic</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes (No-Code)</td>
              </tr>
              <tr class="bg-white">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Update Records from Slack</td>
                <td class="p-4 border border-gray-200 text-center">Limited</td>
                <td class="p-4 border border-gray-200 text-center">No</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes</td>
              </tr>
              <tr class="bg-gray-50">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Pricing</td>
                <td class="p-4 border border-gray-200 text-center">Free (basic)</td>
                <td class="p-4 border border-gray-200 text-center">$19.99+/mo</td>
                <td class="p-4 border border-gray-200 text-center">Free trial, then paid</td>
              </tr>
              <tr class="bg-white">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Best For</td>
                <td class="p-4 border border-gray-200 text-center text-sm">Basic visibility</td>
                <td class="p-4 border border-gray-200 text-center text-sm">Simple automation</td>
                <td class="p-4 border border-gray-200 text-center text-sm font-semibold" style="color: #F94730;">Sales teams needing speed</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Method 1: Native -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8" style="color: #061A35;">
          Method 1: Native Salesforce for Slack
        </h2>

        <div class="bg-white rounded-xl border border-gray-200 p-8 mb-8">
          <h3 class="font-bold text-xl mb-4" style="color: #061A35;">How to Set Up</h3>
          <ol class="space-y-4 text-gray-700">
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">1</span>
              <span>Install the Salesforce app from the Slack App Directory</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">2</span>
              <span>Install the Slack package in Salesforce Setup</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">3</span>
              <span>Apply the Slack Standard User permission set to users</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">4</span>
              <span>Configure Notification Builder in Salesforce Setup</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">5</span>
              <span>Create a Flow to trigger notifications on lead creation</span>
            </li>
          </ol>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-green-50 border border-green-200 rounded-xl p-6">
            <h4 class="font-bold text-green-800 mb-3">Pros</h4>
            <ul class="space-y-2 text-green-700">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Free with Salesforce license</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Official Salesforce support</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Deep Salesforce integration</span>
              </li>
            </ul>
          </div>
          <div class="bg-red-50 border border-red-200 rounded-xl p-6">
            <h4 class="font-bold text-red-800 mb-3">Cons</h4>
            <ul class="space-y-2 text-red-700">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                <span>Complex setup requiring admin skills</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                <span>Alerts can be delayed 1-5 minutes</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                <span>Limited message customization</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Method 2: Zapier -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8" style="color: #061A35;">
          Method 2: Zapier
        </h2>

        <div class="bg-white rounded-xl border border-gray-200 p-8 mb-8">
          <h3 class="font-bold text-xl mb-4" style="color: #061A35;">How to Set Up</h3>
          <ol class="space-y-4 text-gray-700">
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">1</span>
              <span>Create a Zapier account and connect Salesforce</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">2</span>
              <span>Connect your Slack workspace</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">3</span>
              <span>Create a Zap with trigger "New Lead" in Salesforce</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">4</span>
              <span>Add action "Send Channel Message" in Slack</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold">5</span>
              <span>Map Salesforce fields to your Slack message</span>
            </li>
          </ol>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-green-50 border border-green-200 rounded-xl p-6">
            <h4 class="font-bold text-green-800 mb-3">Pros</h4>
            <ul class="space-y-2 text-green-700">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Easy visual builder</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Connects to 6,000+ apps</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>No Salesforce admin needed</span>
              </li>
            </ul>
          </div>
          <div class="bg-red-50 border border-red-200 rounded-xl p-6">
            <h4 class="font-bold text-red-800 mb-3">Cons</h4>
            <ul class="space-y-2 text-red-700">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                <span>Polling delay of 1-15 minutes</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                <span>No actions back to Salesforce from Slack</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                <span>Task-based pricing can get expensive</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Method 3: Pyko (Recommended) -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-[#061A35] to-[#0A2342]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <span class="inline-block px-4 py-1 rounded-full bg-[#F94730] text-white text-sm font-medium mb-4">Recommended</span>
          <h2 class="text-3xl font-bold text-white mb-4">
            Method 3: Pyko
          </h2>
          <p class="text-xl text-gray-300">
            Real-time alerts with one-click actions. Built for sales teams.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur rounded-xl border border-white/20 p-8 mb-8">
          <h3 class="font-bold text-xl mb-4 text-white">How to Set Up (5 minutes)</h3>
          <ol class="space-y-4 text-gray-200">
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#F94730] flex items-center justify-center text-sm font-bold text-white">1</span>
              <span>Start your free trial and connect Slack</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#F94730] flex items-center justify-center text-sm font-bold text-white">2</span>
              <span>Connect Salesforce with one-click OAuth</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#F94730] flex items-center justify-center text-sm font-bold text-white">3</span>
              <span>Choose "New Lead" from template library</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#F94730] flex items-center justify-center text-sm font-bold text-white">4</span>
              <span>Select your Slack channel or enable DM routing</span>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#F94730] flex items-center justify-center text-sm font-bold text-white">5</span>
              <span>Done! Alerts start flowing in real-time</span>
            </li>
          </ol>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div class="bg-white/10 backdrop-blur rounded-xl p-6 text-center">
            <div class="text-4xl font-bold text-[#F94730] mb-2">&lt;3s</div>
            <p class="text-gray-300">Alert delivery using Platform Events</p>
          </div>
          <div class="bg-white/10 backdrop-blur rounded-xl p-6 text-center">
            <div class="text-4xl font-bold text-[#F94730] mb-2">1-click</div>
            <p class="text-gray-300">Update Salesforce without leaving Slack</p>
          </div>
          <div class="bg-white/10 backdrop-blur rounded-xl p-6 text-center">
            <div class="text-4xl font-bold text-[#F94730] mb-2">5 min</div>
            <p class="text-gray-300">Total setup time</p>
          </div>
        </div>

        <div class="text-center">
          <Button href="/trial" variant="primary" size="lg">
            Start Free 14-Day Trial
          </Button>
          <p class="text-sm text-gray-400 mt-4">No credit card required</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Speed Matters -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: #061A35;">
          Why Lead Response Speed Matters
        </h2>

        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <div class="text-center p-6 bg-gray-50 rounded-xl">
            <div class="text-5xl font-bold mb-2" style="color: #F94730;">78%</div>
            <p class="text-gray-700">of customers buy from the first responder</p>
          </div>
          <div class="text-center p-6 bg-gray-50 rounded-xl">
            <div class="text-5xl font-bold mb-2" style="color: #F94730;">10x</div>
            <p class="text-gray-700">higher contact rate within 5 minutes</p>
          </div>
          <div class="text-center p-6 bg-gray-50 rounded-xl">
            <div class="text-5xl font-bold mb-2" style="color: #F94730;">47h</div>
            <p class="text-gray-700">average B2B lead response time</p>
          </div>
        </div>

        <div class="bg-gray-50 p-8 rounded-xl">
          <p class="text-lg text-gray-700 text-center">
            Using a 15-minute polling integration means your competitor using real-time alerts could contact the lead <strong>14 minutes before you</strong>. In sales, that's the difference between winning and losing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">
          Frequently Asked Questions
        </h2>

        <div class="space-y-6">
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-lg mb-2" style="color: #061A35;">What's the fastest way to get Salesforce lead notifications in Slack?</h3>
            <p class="text-gray-700">Pyko uses Salesforce Platform Events to deliver notifications in 1-3 seconds. This is the fastest method available, compared to 1-15 minutes for polling-based solutions like Zapier.</p>
          </div>

          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-lg mb-2" style="color: #061A35;">Can I update Salesforce records directly from Slack?</h3>
            <p class="text-gray-700">Yes, with Pyko you can update fields, change stages, create tasks, and push close dates without ever leaving Slack. Native Salesforce has limited actions, and Zapier doesn't support this at all.</p>
