---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout
  title="Best Rattle Alternatives in 2025 - Salesforce to Slack/Teams Integration"
  description="Looking for Rattle alternatives? Compare Pyko, Scratchpad, and other Salesforce-Slack integration tools. Find the best option for your team's needs and budget."
>
  <!-- Hero Section -->
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/20 text-blue-200 text-sm mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          Comparison Guide
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Best Rattle Alternatives for 2025
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
          Rattle is popular for Salesforce-Slack integration, but it's not the only option. Compare alternatives that offer more flexibility, better pricing, and Microsoft Teams support.
        </p>
        <Button href="/trial" variant="primary" size="lg">
          Try Pyko Free
        </Button>
        <p class="text-sm text-gray-400 mt-4">14-day free trial. No credit card required.</p>
      </div>
    </div>
  </section>

  <!-- Why Look for Alternatives Section -->
  <section class="py-12 bg-white border-b border-gray-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-6">
          <h2 class="text-lg font-bold mb-3" style="color: #061A35;">Why Look for Rattle Alternatives?</h2>
          <p class="text-gray-700 mb-4">
            Rattle is a solid Salesforce-Slack integration tool, but it has limitations that may not work for every team:
          </p>
          <ul class="text-gray-700 space-y-2">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span><strong>Salesforce only</strong> - No HubSpot support for teams on other CRMs</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span><strong>Slack only</strong> - No Microsoft Teams support</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span><strong>Enterprise pricing</strong> - "Contact sales" pricing model isn't transparent</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <span><strong>Complex setup</strong> - May require RevOps involvement for configuration</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-center" style="color: #061A35;">
          Compare Rattle Alternatives
        </h2>
        <p class="text-lg text-gray-600 text-center mb-12">
          Feature-by-feature comparison of the top Salesforce-Slack integration tools.
        </p>

        <div class="overflow-x-auto">
          <table class="w-full border-collapse bg-white text-gray-700">
            <thead>
              <tr class="bg-gray-50">
                <th class="text-left p-4 border border-gray-200 font-semibold" style="color: #061A35;">Feature</th>
                <th class="text-center p-4 border border-gray-200 font-semibold" style="color: #061A35;">Rattle</th>
                <th class="text-center p-4 border border-gray-200 font-semibold" style="color: #061A35;">Scratchpad</th>
                <th class="text-center p-4 border border-gray-200 font-semibold" style="color: #061A35;">Slack Elevate</th>
                <th class="text-center p-4 border border-gray-200 font-semibold" style="color: #F94730;">Pyko</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bg-white">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Real-Time Alerts</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes (&lt;3s)</td>
              </tr>
              <tr class="bg-gray-50">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Update CRM from Chat</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center">Limited</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes</td>
              </tr>
              <tr class="bg-white">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">HubSpot Support</td>
                <td class="p-4 border border-gray-200 text-center text-red-500">No</td>
                <td class="p-4 border border-gray-200 text-center text-red-500">No</td>
                <td class="p-4 border border-gray-200 text-center text-red-500">No</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes</td>
              </tr>
              <tr class="bg-gray-50">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Microsoft Teams</td>
                <td class="p-4 border border-gray-200 text-center text-red-500">No</td>
                <td class="p-4 border border-gray-200 text-center text-red-500">No</td>
                <td class="p-4 border border-gray-200 text-center text-red-500">No</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes</td>
              </tr>
              <tr class="bg-white">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">CRM Data Hygiene</td>
                <td class="p-4 border border-gray-200 text-center">Limited</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center text-red-500">No</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes (Auto)</td>
              </tr>
              <tr class="bg-gray-50">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">No-Code Setup</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center">Yes</td>
                <td class="p-4 border border-gray-200 text-center text-green-600 font-semibold">Yes</td>
              </tr>
              <tr class="bg-white">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Pricing</td>
                <td class="p-4 border border-gray-200 text-center">Contact sales</td>
                <td class="p-4 border border-gray-200 text-center">$0 platform fee</td>
                <td class="p-4 border border-gray-200 text-center">$60/user/mo</td>
                <td class="p-4 border border-gray-200 text-center font-semibold" style="color: #F94730;">From €3.99/user</td>
              </tr>
              <tr class="bg-gray-50">
                <td class="p-4 border border-gray-200 font-medium text-gray-900">Best For</td>
                <td class="p-4 border border-gray-200 text-center text-sm">Enterprise SF + Slack</td>
                <td class="p-4 border border-gray-200 text-center text-sm">Pipeline management</td>
                <td class="p-4 border border-gray-200 text-center text-sm">Full Salesforce orgs</td>
                <td class="p-4 border border-gray-200 text-center text-sm font-semibold" style="color: #F94730;">Flexibility & value</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Pyko Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-[#061A35] to-[#0A2342]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-1 rounded-full bg-[#F94730] text-white text-sm font-medium mb-4">Recommended</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Why Choose Pyko Over Rattle
          </h2>
          <p class="text-xl text-gray-300">
            More integrations, transparent pricing, and faster setup.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mb-12">
          <div class="bg-white/10 backdrop-blur rounded-xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-[#F94730] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3 class="text-xl font-bold text-white">Microsoft Teams Support</h3>
            </div>
            <p class="text-gray-300">Rattle is Slack-only. Pyko works with both Slack and Microsoft Teams, so you're not locked into one platform. Perfect for enterprise teams on M365.</p>
          </div>

          <div class="bg-white/10 backdrop-blur rounded-xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-[#F94730] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <h3 class="text-xl font-bold text-white">HubSpot + Salesforce</h3>
            </div>
            <p class="text-gray-300">Rattle only works with Salesforce. Pyko supports both Salesforce AND HubSpot. If you ever switch CRMs, you won't need a new tool.</p>
          </div>

          <div class="bg-white/10 backdrop-blur rounded-xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-[#F94730] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
              </div>
              <h3 class="text-xl font-bold text-white">Transparent Pricing</h3>
            </div>
            <p class="text-gray-300">Rattle requires you to "contact sales" for pricing. Pyko starts at just €3.99/user/month with clear, published pricing. No surprise quotes.</p>
          </div>

          <div class="bg-white/10 backdrop-blur rounded-xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-[#F94730] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-white">True Real-Time (&lt;3 seconds)</h3>
            </div>
            <p class="text-gray-300">Pyko uses Salesforce Platform Events for instant delivery. No polling delays. Your team gets alerts within 1-3 seconds of CRM changes.</p>
          </div>
        </div>

        <div class="text-center">
          <Button href="/trial" variant="primary" size="lg">
            Try Pyko Free for 14 Days
          </Button>
          <p class="text-sm text-gray-400 mt-4">No credit card required. Set up in 5 minutes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Alternatives -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">
          All Rattle Alternatives Reviewed
        </h2>

        <!-- Pyko -->
        <div class="mb-10 pb-10 border-b border-gray-200">
          <div class="flex items-center gap-3 mb-4">
            <h3 class="text-2xl font-bold" style="color: #061A35;">Pyko</h3>
            <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded">Recommended</span>
          </div>
          <p class="text-gray-700 mb-6">
            Pyko is a real-time CRM-to-chat integration platform that works with Salesforce, HubSpot, Slack, and Microsoft Teams. It offers live alerts, one-click CRM actions, and automated data hygiene rules.
          </p>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="bg-green-50 rounded-lg p-4">
              <p class="font-medium text-green-800 mb-2">Pros:</p>
              <ul class="text-sm text-green-700 space-y-1">
                <li>Works with Slack AND Microsoft Teams</li>
                <li>Supports Salesforce AND HubSpot</li>
                <li>Transparent pricing from €3.99/user</li>
                <li>Real-time alerts in under 3 seconds</li>
                <li>Automated CRM data hygiene</li>
              </ul>
            </div>
            <div class="bg-red-50 rounded-lg p-4">
              <p class="font-medium text-red-800 mb-2">Cons:</p>
              <ul class="text-sm text-red-700 space-y-1">
                <li>Newer to market than Rattle</li>
                <li>No deal rooms feature (yet)</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Rattle -->
        <div class="mb-10 pb-10 border-b border-gray-200">
          <h3 class="text-2xl font-bold mb-4" style="color: #061A35;">Rattle</h3>
          <p class="text-gray-700 mb-6">
            Rattle is a well-established Salesforce-Slack integration tool. It offers bi-directional sync, deal rooms, and no-code workflow building. It's popular among enterprise RevOps teams.
          </p>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="bg-green-50 rounded-lg p-4">
              <p class="font-medium text-green-800 mb-2">Pros:</p>
              <ul class="text-sm text-green-700 space-y-1">
                <li>Established player with enterprise clients</li>
                <li>Deal rooms for collaborative selling</li>
                <li>Strong no-code workflow builder</li>
                <li>Good customer support</li>
              </ul>
            </div>
            <div class="bg-red-50 rounded-lg p-4">
              <p class="font-medium text-red-800 mb-2">Cons:</p>
              <ul class="text-sm text-red-700 space-y-1">
                <li>Salesforce-only (no HubSpot)</li>
                <li>Slack-only (no Microsoft Teams)</li>
                <li>Opaque "contact sales" pricing</li>
                <li>Can be complex to configure</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Scratchpad -->
        <div class="mb-10 pb-10 border-b border-gray-200">
          <h3 class="text-2xl font-bold mb-4" style="color: #061A35;">Scratchpad</h3>
          <p class="text-gray-700 mb-6">
            Scratchpad focuses on sales productivity and pipeline management rather than pure CRM-to-chat integration. It offers a spreadsheet-like interface for updating Salesforce.
          </p>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="bg-green-50 rounded-lg p-4">
              <p class="font-medium text-green-800 mb-2">Pros:</p>
              <ul class="text-sm text-green-700 space-y-1">
                <li>No platform fees</li>
                <li>Great for pipeline management</li>
                <li>Intuitive spreadsheet interface</li>
                <li>Free Troops migration</li>
              </ul>
            </div>
            <div class="bg-red-50 rounded-lg p-4">
              <p class="font-medium text-red-800 mb-2">Cons:</p>
              <ul class="text-sm text-red-700 space-y-1">
                <li>Salesforce-only</li>
                <li>Slack-only</li>
                <li>More pipeline tool than alerts tool</li>
                <li>Less focus on real-time notifications</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Slack Sales Elevate -->
        <div class="mb-10 pb-10 border-b border-gray-200">
          <h3 class="text-2xl font-bold mb-4" style="color: #061A35;">Slack Sales Elevate</h3>
          <p class="text-gray-700 mb-6">
            Salesforce's official Salesforce-Slack integration. It's native to both platforms but comes with premium pricing at $60/user/month.
          </p>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="bg-green-50 rounded-lg p-4">
              <p class="font-medium text-green-800 mb-2">Pros:</p>
              <ul class="text-sm text-green-700 space-y-1">
                <li>Native Salesforce integration</li>
                <li>Official Salesforce support</li>
                <li>Deep Slack integration</li>
              </ul>
            </div>
            <div class="bg-red-50 rounded-lg p-4">
              <p class="font-medium text-red-800 mb-2">Cons:</p>
              <ul class="text-sm text-red-700 space-y-1">
                <li>$60/user/month (very expensive)</li>
                <li>Salesforce-only</li>
                <li>Slack-only</li>
                <li>Limited customization</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Luru -->
        <div class="mb-10">
          <h3 class="text-2xl font-bold mb-4" style="color: #061A35;">Luru</h3>
          <p class="text-gray-700 mb-6">
            Luru offers CRM-to-Slack integration with a focus on revenue intelligence and meeting automation. It includes features like meeting transcription.
          </p>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="bg-green-50 rounded-lg p-4">
              <p class="font-medium text-green-800 mb-2">Pros:</p>
              <ul class="text-sm text-green-700 space-y-1">
                <li>Meeting intelligence features</li>
                <li>One-click Slack setup</li>
                <li>CRM action buttons in chat</li>
              </ul>
            </div>
            <div class="bg-red-50 rounded-lg p-4">
              <p class="font-medium text-red-800 mb-2">Cons:</p>
              <ul class="text-sm text-red-700 space-y-1">
                <li>Salesforce-only</li>
                <li>Slack-only</li>
                <li>Smaller company</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rattle vs Pyko Deep Dive -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center" style="color: #061A35;">
          Rattle vs Pyko: Head-to-Head
        </h2>

        <div class="space-y-6">
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-lg mb-3" style="color: #061A35;">Platform Support</h3>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="text-sm">
                <p class="font-medium text-gray-900 mb-2">Rattle:</p>
                <p class="text-gray-600">Salesforce + Slack only</p>
              </div>
              <div class="text-sm">
                <p class="font-medium text-gray-900 mb-2">Pyko:</p>
                <p class="text-green-600 font-medium">Salesforce + HubSpot + Slack + Microsoft Teams</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-lg mb-3" style="color: #061A35;">Pricing Model</h3>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="text-sm">
                <p class="font-medium text-gray-900 mb-2">Rattle:</p>
                <p class="text-gray-600">"Contact sales" - opaque enterprise pricing</p>
              </div>
              <div class="text-sm">
                <p class="font-medium text-gray-900 mb-2">Pyko:</p>
                <p class="text-green-600 font-medium">From €3.99/user/month - published pricing</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-lg mb-3" style="color: #061A35;">Target Customer</h3>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="text-sm">
                <p class="font-medium text-gray-900 mb-2">Rattle:</p>
                <p class="text-gray-600">Enterprise RevOps teams already on Salesforce + Slack</p>
              </div>
              <div class="text-sm">
                <p class="font-medium text-gray-900 mb-2">Pyko:</p>
                <p class="text-green-600 font-medium">Teams of all sizes wanting flexibility and value</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-lg mb-3" style="color: #061A35;">Data Hygiene</h3>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="text-sm">
                <p class="font-medium text-gray-900 mb-2">Rattle:</p>
                <p class="text-gray-600">Basic data alerts</p>
              </div>
              <div class="text-sm">
                <p class="font-medium text-gray-900 mb-2">Pyko:</p>
                <p class="text-green-600 font-medium">Automated Cleaning Rules with one-click fixes</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">
          Frequently Asked Questions
        </h2>

        <div class="space-y-6">
          <div class="bg-gray-50 rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-lg mb-2" style="color: #061A35;">Is Rattle free?</h3>
