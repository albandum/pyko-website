---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
---

<MainLayout title="Contact Us" description="Get in touch with the Pyko team.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">Get in Touch</h1>
        <p class="text-xl text-gray-700">Have a question? Want to see a demo? We'd love to hear from you.</p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <div>
          <h2 class="text-2xl font-bold text-navy mb-6">Send us a message</h2>
          <form class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Name *</label>
              <input type="text" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-accent focus:border-accent" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Email *</label>
              <input type="email" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-accent focus:border-accent" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Company</label>
              <input type="text" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-accent focus:border-accent" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Message *</label>
              <textarea rows="5" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-accent focus:border-accent"></textarea>
            </div>
            <Button variant="primary" size="lg" class="w-full">Send Message</Button>
          </form>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-navy mb-6">Other ways to reach us</h2>
          <div class="space-y-6">
            <div>
              <h3 class="font-semibold text-navy mb-2">📧 Email</h3>
              <p class="text-gray-700">support@pyko.com</p>
            </div>
            <div>
              <h3 class="font-semibold text-navy mb-2">💼 Sales</h3>
              <p class="text-gray-700">sales@pyko.com</p>
            </div>
            <div>
              <h3 class="font-semibold text-navy mb-2">📚 Documentation</h3>
              <a href="/docs" class="text-accent hover:text-accent-dark">View our docs</a>
            </div>
            <div>
              <h3 class="font-semibold text-navy mb-2">🔗 Social</h3>
              <div class="flex gap-4">
                <a href="#" class="text-accent hover:text-accent-dark">LinkedIn</a>
                <a href="#" class="text-accent hover:text-accent-dark">Twitter</a>
              </div>
            </div>
          </div>

          <div class="mt-12 p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-navy mb-4">Prefer to try it yourself?</h3>
            <Button href="/trial" variant="primary" class="w-full">Start Free 14-Day Trial</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
