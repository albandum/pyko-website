---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
---

<MainLayout title="Contact Us" description="Get in touch with the Pyko team.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">Get in Touch</h1>
        <p class="text-xl text-gray-700 mb-8">Have a question? Want to see a demo? We'd love to hear from you.</p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-accent/10 rounded-full mb-6">
            <svg class="w-10 h-10 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-navy mb-4">Contact Us</h2>
          <p class="text-lg text-gray-700 mb-6">
            For any questions, support requests, or inquiries, please reach out to us at:
          </p>
          <a href="mailto:support@pyko.co" class="inline-block text-2xl font-semibold text-accent hover:text-accent-dark transition-colors">
            support@pyko.co
          </a>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mt-12">
          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-navy mb-3">📚 Documentation</h3>
            <p class="text-gray-700 mb-4">Find answers in our comprehensive documentation.</p>
            <a href="/docs" class="text-accent hover:text-accent-dark font-semibold">View Docs →</a>
          </div>

          <div class="p-6 bg-gray-50 rounded-xl">
            <h3 class="font-bold text-navy mb-3">🚀 Try Pyko</h3>
            <p class="text-gray-700 mb-4">Start your free 14-day trial today.</p>
            <Button href="/trial" variant="primary" class="w-full">Start Free Trial</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
