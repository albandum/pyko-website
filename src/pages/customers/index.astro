---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import CTASection from '../../components/CTASection.astro';

// Customer stories data
const stories = [
  {
    slug: 'lifen',
    company: 'Lifen',
    logo: '/images/customers/lifen.png',
    person: {
      name: 'Raphael Brousse',
      role: 'VP of Operations',
      photo: '/images/customers/testimonials/lifen/raphael.jpeg'
    },
    quote: 'We love Pyko at Lifen. It is a very intuitive, simple yet powerful tool, widely adopted by our Business & Operations teams.',
    stats: {
      automations: '20+',
      mainBenefit: '100+ Users'
    },
    tags: ['Operations', 'Salesforce', 'Data Quality']
  },
  {
    slug: 'sunday',
    company: 'Sunday',
    logo: '/images/customers/sunday.png',
    person: {
      name: 'Robin Iss',
      role: 'Head of RevOps',
      photo: '/images/customers/testimonials/sunday/person.jpeg'
    },
    quote: 'The most underrated and least known tool in a RevOps stack with Salesforce.',
    stats: {
      automations: '20+',
      mainBenefit: 'Data Quality'
    },
    tags: ['RevOps', 'Salesforce', 'Data Quality']
  }
];
---

<MainLayout
  title="Customers"
  description="See how revenue teams use Pyko to automate their CRM workflows and improve data quality."
>
  <!-- Hero Section -->
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Customers
        </h1>
        <p class="text-xl text-gray-300 mb-8">
          See how revenue teams are transforming their workflows with Pyko
        </p>
      </div>
    </div>
  </section>

  <!-- Stories Grid -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {stories.map((story) => (
          <a
            href={`/customers/${story.slug}`}
            class="group block bg-white rounded-xl border border-gray-200 overflow-hidden hover:border-primary transition-all duration-300 hover:shadow-lg"
          >
            <!-- Company Header -->
            <div class="p-6 border-b border-gray-100 bg-white">
              <div class="flex items-center justify-between">
                <div class="h-8 flex items-center">
                  <img
                    src={story.logo}
                    alt={story.company}
                    class="h-full w-auto object-contain"
                  />
                </div>
                <div class="flex gap-2">
                  {story.tags.slice(0, 2).map((tag) => (
                    <span class="px-2 py-1 text-xs rounded-full text-gray-600" style="background-color: #F3F4F6;">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <!-- Quote -->
              <blockquote class="text-gray-700 mb-6 text-lg leading-relaxed">
                "{story.quote}"
              </blockquote>

              <!-- Stats -->
              <div class="flex gap-4 mb-6">
                <div class="flex-1 p-3 rounded-lg bg-gray-50 text-center">
                  <div class="text-2xl font-bold" style="color: #F94730;">{story.stats.automations}</div>
                  <div class="text-xs text-gray-500">Automations</div>
                </div>
                <div class="flex-1 p-3 rounded-lg bg-gray-50 text-center">
                  <div class="text-sm font-semibold" style="color: #061A35;">{story.stats.mainBenefit}</div>
                  <div class="text-xs text-gray-500">Key Benefit</div>
                </div>
              </div>

              <!-- Author -->
              <div class="flex items-center gap-3">
                <img
                  src={story.person.photo}
                  alt={story.person.name}
                  class="w-12 h-12 rounded-full object-cover"
                />
                <div>
                  <div class="font-semibold" style="color: #061A35;">{story.person.name}</div>
                  <div class="text-sm text-gray-500">{story.person.role} at {story.company}</div>
                </div>
              </div>
            </div>

            <!-- Read More -->
            <div class="px-6 pb-6">
              <span class="inline-flex items-center text-sm font-medium group-hover:gap-2 transition-all" style="color: #F94730;">
                Read full story
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}

        <!-- Coming Soon Card -->
        <div class="bg-gray-50 rounded-xl border border-dashed border-gray-300 flex items-center justify-center p-8 min-h-[400px]">
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-600 mb-2">More stories coming soon</h3>
            <p class="text-sm text-gray-500">Want to share your story?</p>
            <a href="/contact" class="text-sm font-medium mt-2 inline-block" style="color: #F94730;">
              Get in touch
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection
    headline="Ready to write your success story?"
    subheadline="Join teams like Lifen and Sunday who transformed their revenue operations with Pyko."
    primaryCTA={{ text: "Start Free Trial", href: "/trial" }}
    secondaryCTA={{ text: "Talk to Sales", href: "/contact" }}
    variant="gradient"
  />
</MainLayout>
