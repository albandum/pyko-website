---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout title="Salesforce Integration" description="Connect Pyko to Salesforce in 30 seconds. Get real-time alerts using Platform Events and take action without opening a browser.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="flex items-center justify-center gap-4 mb-6">
          <img src="/images/logos/salesforce.svg" alt="Salesforce" class="h-16 w-16" />
          <span class="text-4xl text-white">×</span>
          <img src="/images/logos/pyko-logo-sm.png" alt="Pyko" class="h-12" />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Salesforce alerts and actions in Slack</h1>
        <p class="text-xl text-gray-300 mb-8">Connect Pyko to Salesforce in 30 seconds with OAuth. Get real-time alerts using Platform Events and take action without opening a browser.</p>
        <Button href="/trial" variant="primary" size="lg">Connect Salesforce</Button>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">Connect in 3 clicks</h2>
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center p-6">
          <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-xl" style="background-color: #F94730;">1</div>
          <h3 class="font-bold mb-2" style="color: #061A35;">Click "Connect Salesforce" in Pyko</h3>
        </div>
        <div class="text-center p-6">
          <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-xl" style="background-color: #F94730;">2</div>
          <h3 class="font-bold mb-2" style="color: #061A35;">Authorize Pyko in Salesforce OAuth</h3>
        </div>
        <div class="text-center p-6">
          <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-xl" style="background-color: #F94730;">3</div>
          <h3 class="font-bold mb-2" style="color: #061A35;">Done! Start creating automations</h3>
        </div>
      </div>
      <p class="text-center text-gray-700 mt-8">⏱️ Less than 30 seconds • 🔒 Your credentials never touch our servers</p>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">Key Features</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <FeatureCard icon="zap" title="Real-Time with Platform Events" description="True real-time push notifications using Salesforce Platform Events and Flows." />
        <FeatureCard icon="eye" title="SOQL Query Support" description="All the power of SOQL, none of the code. Complex WHERE clauses with AND/OR logic." />
        <FeatureCard icon="settings" title="Custom Objects" description="Works with your custom objects and fields automatically." />
        <FeatureCard icon="shield" title="Sandbox & Production" description="Test safely in Sandbox before deploying to Production." />
        <FeatureCard icon="check-circle" title="Secure by Default" description="Respects Salesforce sharing rules and field-level security." />
        <FeatureCard icon="file-check" title="Pre-built Templates" description="10+ Salesforce-specific automation templates ready to deploy." />
      </div>
    </div>
  </section>

  <CTASection headline="Ready to bring Salesforce into Slack?" primaryCTA={{ text: "Start Free Trial", href: "/trial" }} variant="gradient" />
</MainLayout>
