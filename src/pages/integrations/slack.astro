---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout title="Slack Integration" description="Install the Pyko bot in your Slack workspace. Get rich, interactive CRM alerts in any channel or direct message.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">Your CRM. In Slack.</h1>
        <p class="text-xl text-gray-700 mb-8">Install the Pyko bot in your Slack workspace. Get rich, interactive CRM alerts in any channel or direct message.</p>
        <Button href="/trial" variant="primary" size="lg">Add to Slack</Button>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-navy mb-12 text-center">Key Features</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <FeatureCard icon="📢" title="Channel & DM Routing" description="Send to public/private channels or direct messages. Route dynamically based on CRM data." />
        <FeatureCard icon="@" title="User Mentions" description="@mention users by CRM field. Get the right person's attention instantly." />
        <FeatureCard icon="🎛️" title="Interactive Buttons" description="Take action without leaving Slack. Update records, push dates, create tasks." />
        <FeatureCard icon="🎨" title="Block Kit Messages" description="Beautiful, structured messages using Slack's Block Kit." />
        <FeatureCard icon="💬" title="Thread Replies" description="Keep channels clean with thread-based replies and updates." />
        <FeatureCard icon="🏢" title="Enterprise Grid" description="Works with Slack Enterprise Grid, shared channels, and multi-workspace." />
      </div>
    </div>
  </section>

  <CTASection headline="Ready to bring your CRM into Slack?" primaryCTA={{ text: "Add to Slack", href: "/trial" }} variant="gradient" />
</MainLayout>
