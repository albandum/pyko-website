---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout title="HubSpot Integration" description="Connect Pyko to HubSpot via OAuth. Get intelligent alerts every 5 minutes and take action instantly.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="flex items-center justify-center gap-4 mb-6">
          <img src="/images/logos/hubspot.svg" alt="HubSpot" class="h-16 w-16" />
          <span class="text-4xl text-white">×</span>
          <img src="/images/logos/pyko-logo-sm.png" alt="Pyko" class="h-12" />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">HubSpot automation in Slack and Teams</h1>
        <p class="text-xl text-gray-300 mb-8">Connect Pyko to HubSpot via secure OAuth. Get intelligent polling-based alerts every 5 minutes.</p>
        <Button href="/trial" variant="primary" size="lg">Connect HubSpot</Button>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-center" style="color: #061A35;">Quick & secure OAuth connection</h2>
        <p class="text-lg text-gray-700 text-center mb-12">Connect your HubSpot account in seconds with our secure OAuth 2.0 flow. Your credentials never touch our servers.</p>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="text-center p-6">
            <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-xl" style="background-color: #F94730;">1</div>
            <h3 class="font-bold mb-2" style="color: #061A35;">Click Connect</h3>
            <p class="text-sm text-gray-700">Start the OAuth flow in Pyko</p>
          </div>
          <div class="text-center p-6">
            <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-xl" style="background-color: #F94730;">2</div>
            <h3 class="font-bold mb-2" style="color: #061A35;">Authorize</h3>
            <p class="text-sm text-gray-700">Grant permissions in HubSpot</p>
          </div>
          <div class="text-center p-6">
            <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-bold text-xl" style="background-color: #F94730;">3</div>
            <h3 class="font-bold mb-2" style="color: #061A35;">Done!</h3>
            <p class="text-sm text-gray-700">Start creating automations</p>
          </div>
        </div>

        <div class="mt-8 p-6 bg-gray-50 rounded-xl text-center">
          <p class="text-sm text-gray-700"><strong style="color: #061A35;">Setup time:</strong> Less than 30 seconds • <strong style="color: #061A35;">Works with:</strong> All HubSpot accounts (Free, Starter, Professional, Enterprise)</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">Key Features</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <FeatureCard icon="⏱️" title="Intelligent Polling (5 min)" description="Check for changes every 5 minutes using HubSpot's Search API." />
        <FeatureCard icon="🎨" title="Custom Properties" description="Works with all your custom HubSpot properties automatically." />
        <FeatureCard icon="🌍" title="Multi-Region Support" description="Works with NA1, EU1, and all HubSpot regions." />
        <FeatureCard icon="🔗" title="Associated Records" description="Show Company data on Contact alerts, Deal owner on Deal notifications." />
        <FeatureCard icon="📦" title="All CRM Objects" description="Contacts, Companies, Deals, Tickets, and custom objects." />
        <FeatureCard icon="📚" title="Pre-built Templates" description="10+ HubSpot-specific automation templates." />
      </div>
    </div>
  </section>

  <CTASection headline="Ready to bring HubSpot into Slack?" primaryCTA={{ text: "Start Free Trial", href: "/trial" }} variant="gradient" />
</MainLayout>
