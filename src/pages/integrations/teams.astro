---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout title="Microsoft Teams Integration" description="Install Pyko in Teams to get adaptive card alerts in channels or 1:1 chats. Perfect for organizations standardizing on Microsoft 365.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="flex items-center justify-center gap-4 mb-6">
          <img src="/images/logos/teams.svg" alt="Microsoft Teams" class="h-16 w-16" />
          <span class="text-4xl text-white">×</span>
          <img src="/images/logos/pyko-logo-sm.png" alt="Pyko" class="h-12" />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">CRM automation for Microsoft Teams</h1>
        <p class="text-xl text-gray-300 mb-8">Install Pyko in Teams to get adaptive card alerts in channels or 1:1 chats. Perfect for organizations on Microsoft 365.</p>
        <Button href="/trial" variant="primary" size="lg">Add to Teams</Button>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">Key Features</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <FeatureCard icon="sparkles" title="Adaptive Cards" description="Rich, interactive cards using Microsoft Adaptive Cards for beautiful messages." />
        <FeatureCard icon="send" title="Channels & 1:1 Chat" description="Post to team channels for group visibility or send personal alerts via direct chat." />
        <FeatureCard icon="shield" title="Azure AD Auth" description="Secure with Azure Active Directory. SSO, MFA, Conditional Access support." />
        <FeatureCard icon="mouse-pointer-click" title="Interactive Actions" description="Update CRM from Teams with action buttons. Success confirmations update the card." />
        <FeatureCard icon="check-circle" title="Enterprise Features" description="Multi-tenant support, compliance (data residency, retention), admin controls." />
        <FeatureCard icon="bar-chart" title="Graph API Integration" description="Deep integration with Microsoft 365 for user directory and team management." />
      </div>
    </div>
  </section>

  <CTASection headline="Ready to bring your CRM into Teams?" primaryCTA={{ text: "Add to Teams", href: "/trial" }} variant="gradient" />
</MainLayout>
