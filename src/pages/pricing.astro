---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
---

<MainLayout title="Pricing - Simple, Transparent" description="Volume discounts up to 50%. The more users, the less you pay per seat.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Simple, transparent pricing</h1>
        <p class="text-xl text-gray-300 mb-4">Volume discounts up to 50%. The more users, the less you pay per seat.</p>
        <p class="text-lg text-gray-300">All features included. No hidden fees.</p>
      </div>
    </div>
  </section>

  <!-- Interactive Pricing Calculator -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <!-- Calculator Card -->
        <div class="bg-white rounded-2xl p-8 md:p-12">
          <div class="text-center mb-8">
            <h2 class="text-3xl md:text-4xl font-bold mb-2" style="color: #061A35;">Calculate your price</h2>
            <p class="text-gray-700">Slide to see your volume discount</p>
          </div>

          <!-- Slider -->
          <div class="mb-12">
            <label class="block text-sm font-semibold mb-4 text-gray-700">Number of users</label>
            <input
              type="range"
              id="userSlider"
              min="1"
              max="500"
              value="30"
              class="w-full h-3 rounded-lg appearance-none cursor-pointer"
              style="background: linear-gradient(to right, #F94730 0%, #F94730 6%, #e5e7eb 6%, #e5e7eb 100%);"
            />
            <div class="flex justify-between mt-2 text-sm text-gray-600">
              <span>1</span>
              <span>100</span>
              <span>250</span>
              <span>500</span>
            </div>
          </div>

          <!-- Results -->
          <div class="text-center space-y-6">
            <div>
              <div class="text-6xl font-bold mb-2" style="color: #061A35;">
                <span id="userCount">30</span> users
              </div>
              <div id="discountBadge" class="inline-block px-4 py-2 rounded-full text-white font-semibold" style="background-color: #10B981;">
                Standard rate
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6 max-w-2xl mx-auto">
              <div class="p-6 bg-gray-50 rounded-xl">
                <div class="text-sm text-gray-600 mb-2">Average per user</div>
                <div class="text-4xl font-bold" style="color: #061A35;">
                  €<span id="pricePerUser">7.99</span>
                </div>
                <div class="text-sm text-gray-600 mt-1">per month</div>
              </div>

              <div class="p-6 rounded-xl" style="background-color: rgba(249, 71, 48, 0.1);">
                <div class="text-sm text-gray-600 mb-2">Total monthly cost</div>
                <div class="text-4xl font-bold" style="color: #F94730;">
                  €<span id="totalCost">239.70</span>
                </div>
                <div class="text-sm text-gray-600 mt-1">billed monthly</div>
              </div>
            </div>

            <div class="pt-6">
              <Button href="/trial" variant="primary" size="lg">Start 14-Day Free Trial</Button>
              <p class="text-sm text-gray-600 mt-3">No credit card required</p>
            </div>
          </div>
        </div>

        <!-- Volume Discount Table -->
        <div class="mt-12 bg-gray-50 rounded-xl p-8">
          <h3 class="text-xl font-bold mb-6 text-center" style="color: #061A35;">Volume discount tiers</h3>
          <div class="grid md:grid-cols-5 gap-4">
            <div class="text-center p-4 bg-white rounded-lg">
              <div class="text-sm font-semibold mb-2" style="color: #061A35;">1-30 users</div>
              <div class="text-2xl font-bold text-gray-700">€7.99</div>
              <div class="text-xs text-gray-500 mt-1">Standard</div>
            </div>
            <div class="text-center p-4 bg-white rounded-lg">
              <div class="text-sm font-semibold mb-2" style="color: #061A35;">31-50 users</div>
              <div class="text-2xl font-bold text-gray-700">€6.99</div>
              <div class="text-xs mt-1" style="color: #10B981;">Save 12%</div>
            </div>
            <div class="text-center p-4 bg-white rounded-lg">
              <div class="text-sm font-semibold mb-2" style="color: #061A35;">51-70 users</div>
              <div class="text-2xl font-bold text-gray-700">€5.99</div>
              <div class="text-xs mt-1" style="color: #10B981;">Save 25%</div>
            </div>
            <div class="text-center p-4 bg-white rounded-lg">
              <div class="text-sm font-semibold mb-2" style="color: #061A35;">71-90 users</div>
              <div class="text-2xl font-bold text-gray-700">€4.99</div>
              <div class="text-xs mt-1" style="color: #10B981;">Save 38%</div>
            </div>
            <div class="text-center p-4 bg-white rounded-lg">
              <div class="text-sm font-semibold mb-2" style="color: #061A35;">91+ users</div>
              <div class="text-2xl font-bold text-gray-700">€3.99</div>
              <div class="text-xs mt-1" style="color: #10B981;">Save 50%</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">Everything included</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex items-start gap-3">
            <span class="text-xl" style="color: #10B981;">✓</span>
            <div>
              <div class="font-semibold mb-1" style="color: #061A35;">Salesforce or HubSpot</div>
              <div class="text-sm text-gray-700">Connect your CRM (pick one)</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-xl" style="color: #10B981;">✓</span>
            <div>
              <div class="font-semibold mb-1" style="color: #061A35;">Slack or Teams</div>
              <div class="text-sm text-gray-700">Choose your chat platform (pick one)</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-xl" style="color: #10B981;">✓</span>
            <div>
              <div class="font-semibold mb-1" style="color: #061A35;">Unlimited automations</div>
              <div class="text-sm text-gray-700">Live alerts, actions, and cleaning rules</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-xl" style="color: #10B981;">✓</span>
            <div>
              <div class="font-semibold mb-1" style="color: #061A35;">Complete analytics</div>
              <div class="text-sm text-gray-700">Track usage, ROI, and engagement</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-xl" style="color: #10B981;">✓</span>
            <div>
              <div class="font-semibold mb-1" style="color: #061A35;">Priority support</div>
              <div class="text-sm text-gray-700">Email and chat support included</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-xl" style="color: #10B981;">✓</span>
            <div>
              <div class="font-semibold mb-1" style="color: #061A35;">Pre-built templates</div>
              <div class="text-sm text-gray-700">50+ ready-to-use automations</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">Frequently Asked Questions</h2>
      <div class="max-w-3xl mx-auto space-y-4">
        <div class="bg-gray-50 p-6 rounded-xl">
          <h3 class="font-bold mb-2" style="color: #061A35;">What counts as a "user"?</h3>
          <p class="text-gray-700 text-sm">Any person who creates automations or receives alerts in Slack/Teams. View-only analytics access is free and doesn't count toward your user limit.</p>
        </div>
        <div class="bg-gray-50 p-6 rounded-xl">
          <h3 class="font-bold mb-2" style="color: #061A35;">How does volume pricing work?</h3>
          <p class="text-gray-700 text-sm">It works like tax brackets - your first 30 users are €7.99 each, then users 31-50 are €6.99 each, and so on. The more users you have, the lower your average price per user.</p>
        </div>
        <div class="bg-gray-50 p-6 rounded-xl">
          <h3 class="font-bold mb-2" style="color: #061A35;">Can I change the number of users?</h3>
          <p class="text-gray-700 text-sm">Yes! Add or remove users anytime. Billing adjusts automatically at your next billing cycle.</p>
        </div>
        <div class="bg-gray-50 p-6 rounded-xl">
          <h3 class="font-bold mb-2" style="color: #061A35;">Do you offer a free trial?</h3>
          <p class="text-gray-700 text-sm">Yes! 14 days of full access with all features included. No credit card required to start.</p>
        </div>
        <div class="bg-gray-50 p-6 rounded-xl">
          <h3 class="font-bold mb-2" style="color: #061A35;">What if I have more than 500 users?</h3>
          <p class="text-gray-700 text-sm">Contact our sales team for enterprise pricing. We offer custom volume discounts for larger teams (500+ users) with additional benefits like SSO, dedicated support, and SLAs.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection headline="Start your free 14-day trial" subheadline="No credit card required. All features included." primaryCTA={{ text: "Start Free Trial", href: "/trial" }} variant="gradient" />
</MainLayout>

<script>
  // Pricing calculator logic
  const slider = document.getElementById('userSlider') as HTMLInputElement;
  const userCount = document.getElementById('userCount');
  const pricePerUser = document.getElementById('pricePerUser');
  const totalCost = document.getElementById('totalCost');
  const discountBadge = document.getElementById('discountBadge');

  // Tiered pricing calculation (like tax brackets)
  function calculateTotalCost(users: number): number {
    let total = 0;

    if (users <= 30) {
      total = users * 7.99;
    } else if (users <= 50) {
      total = (30 * 7.99) + ((users - 30) * 6.99);
    } else if (users <= 70) {
      total = (30 * 7.99) + (20 * 6.99) + ((users - 50) * 5.99);
    } else if (users <= 90) {
      total = (30 * 7.99) + (20 * 6.99) + (20 * 5.99) + ((users - 70) * 4.99);
    } else {
      // 91+ users all pay €3.99 each
      total = (30 * 7.99) + (20 * 6.99) + (20 * 5.99) + (20 * 4.99) + ((users - 90) * 3.99);
    }

    return total;
  }

  function getAveragePrice(users: number): number {
    const total = calculateTotalCost(users);
    return total / users;
  }

  function getDiscountText(users: number): string {
    if (users <= 30) return 'Standard rate';
    const avgPrice = getAveragePrice(users);
    const savings = ((7.99 - avgPrice) / 7.99 * 100).toFixed(0);
    return `Save ${savings}%`;
  }

  function getDiscountColor(users: number): string {
    if (users <= 30) return '#10B981';
    if (users <= 50) return '#10B981';
    if (users <= 70) return '#059669';
    if (users <= 90) return '#047857';
    return '#065F46';
  }

  function updatePricing() {
    const users = parseInt(slider.value);
    const total = calculateTotalCost(users);
    const avgPrice = getAveragePrice(users);
    const discount = getDiscountText(users);
    const color = getDiscountColor(users);

    if (userCount) userCount.textContent = users.toString();
    if (pricePerUser) pricePerUser.textContent = avgPrice.toFixed(2);
    if (totalCost) totalCost.textContent = total.toFixed(2);
    if (discountBadge) {
      discountBadge.textContent = discount;
      discountBadge.style.backgroundColor = color;
    }

    // Update slider gradient
    const percentage = ((users - 1) / 499) * 100;
    slider.style.background = `linear-gradient(to right, #F94730 0%, #F94730 ${percentage}%, #e5e7eb ${percentage}%, #e5e7eb 100%)`;
  }

  if (slider) {
    slider.addEventListener('input', updatePricing);
    updatePricing(); // Initialize
  }
</script>

<style>
  /* Custom slider styling */
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #F94730;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(249, 71, 48, 0.3);
  }

  input[type="range"]::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #F94730;
    cursor: pointer;
    border: none;
    box-shadow: 0 2px 8px rgba(249, 71, 48, 0.3);
  }

  input[type="range"]::-webkit-slider-thumb:hover {
    box-shadow: 0 2px 12px rgba(249, 71, 48, 0.5);
  }

  input[type="range"]::-moz-range-thumb:hover {
    box-shadow: 0 2px 12px rgba(249, 71, 48, 0.5);
  }
</style>
