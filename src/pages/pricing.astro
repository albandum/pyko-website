---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
---

<MainLayout title="Pricing - Simple, Transparent" description="Enterprise features without enterprise pricing. Pay for users, not usage.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-navy mb-6">Simple, transparent pricing</h1>
        <p class="text-xl text-gray-700 mb-8">Enterprise features without enterprise pricing. Pay for users, not usage.</p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Starter -->
        <div class="p-8 bg-white rounded-xl border-2 border-gray-200 hover:border-accent transition-all">
          <h3 class="text-2xl font-bold text-navy mb-2">Starter</h3>
          <div class="mb-6">
            <span class="text-4xl font-bold text-navy">$29</span>
            <span class="text-gray-600">/user/month</span>
            <div class="text-sm text-gray-500">billed annually</div>
          </div>
          <ul class="space-y-3 mb-8 text-sm">
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>1 CRM connection</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>1 chat platform</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>10 active automations</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>1,000 runs per month</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Basic analytics (30-day)</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Email support</span></li>
          </ul>
          <Button href="/trial" variant="outline" class="w-full">Start Free Trial</Button>
          <p class="text-xs text-gray-500 text-center mt-4">Best for 5-15 reps</p>
        </div>

        <!-- Professional (Most Popular) -->
        <div class="p-8 bg-accent/5 rounded-xl border-2 border-accent relative">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-accent text-white px-4 py-1 rounded-full text-sm font-semibold">
            Most Popular
          </div>
          <h3 class="text-2xl font-bold text-navy mb-2">Professional</h3>
          <div class="mb-6">
            <span class="text-4xl font-bold text-navy">$59</span>
            <span class="text-gray-600">/user/month</span>
            <div class="text-sm text-gray-500">billed annually</div>
          </div>
          <ul class="space-y-3 mb-8 text-sm">
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Everything in Starter</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Both Slack AND Teams</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Unlimited automations</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>10,000 runs per month</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Complete analytics (1-year)</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Priority support</span></li>
          </ul>
          <Button href="/trial" variant="primary" class="w-full">Start Free Trial</Button>
          <p class="text-xs text-gray-500 text-center mt-4">Best for 15-100 reps</p>
        </div>

        <!-- Enterprise -->
        <div class="p-8 bg-white rounded-xl border-2 border-gray-200 hover:border-accent transition-all">
          <h3 class="text-2xl font-bold text-navy mb-2">Enterprise</h3>
          <div class="mb-6">
            <span class="text-4xl font-bold text-navy">Custom</span>
            <div class="text-sm text-gray-500">contact sales</div>
          </div>
          <ul class="space-y-3 mb-8 text-sm">
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Everything in Professional</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Multiple CRM connections</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Unlimited runs</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>Dedicated success manager</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>SSO/SAML</span></li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span><span>SLA & phone support</span></li>
          </ul>
          <Button href="/contact" variant="outline" class="w-full">Contact Sales</Button>
          <p class="text-xs text-gray-500 text-center mt-4">Best for 100+ reps</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-navy mb-8 text-center">Frequently Asked Questions</h2>
      <div class="max-w-3xl mx-auto space-y-6">
        <div class="bg-white p-6 rounded-xl">
          <h3 class="font-bold text-navy mb-2">What counts as a "user"?</h3>
          <p class="text-gray-700 text-sm">Any person who creates automations or receives alerts. View-only analytics access is free.</p>
        </div>
        <div class="bg-white p-6 rounded-xl">
          <h3 class="font-bold text-navy mb-2">What happens if I exceed my run limit?</h3>
          <p class="text-gray-700 text-sm">We'll notify you and give you the option to upgrade. We never shut off automations mid-month.</p>
        </div>
        <div class="bg-white p-6 rounded-xl">
          <h3 class="font-bold text-navy mb-2">Can I switch plans?</h3>
          <p class="text-gray-700 text-sm">Yes, upgrade or downgrade anytime. Changes take effect at your next billing cycle.</p>
        </div>
        <div class="bg-white p-6 rounded-xl">
          <h3 class="font-bold text-navy mb-2">Do you offer a free trial?</h3>
          <p class="text-gray-700 text-sm">Yes! 14 days of full Professional tier access. No credit card required.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection headline="Start your free 14-day trial" subheadline="No credit card required" primaryCTA={{ text: "Start Free Trial", href: "/trial" }} variant="gradient" />
</MainLayout>
