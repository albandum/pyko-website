---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StatCard from '../components/StatCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import CTASection from '../components/CTASection.astro';
import HeroMockup from '../components/HeroMockup.astro';
---

<MainLayout
  title="Pyko - Your Revenue Radar"
  description="Instant CRM alerts and one-click actions in Slack and Teams. Never miss a deal signal again."
>
  <!-- Hero Section -->
  <section class="gradient-hero py-16 md:py-24 lg:py-32">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Text Content -->
        <div class="text-center lg:text-left">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Your Revenue Radar
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed">
            Instant CRM alerts and one-click actions in Slack and Teams. Never miss a deal signal again.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8">
            <Button href="/trial" variant="primary" size="lg">
              Start Free 14-Day Trial
            </Button>
            <Button href="#demo" variant="outline" size="lg">
              See How It Works
            </Button>
          </div>
          <p class="text-sm text-gray-400">
            ✓ No credit card required  ✓ 14-day free trial  ✓ Setup in 5 minutes
          </p>
        </div>

        <!-- Right: Visual Mockup -->
        <div class="relative hidden lg:block">
          <HeroMockup />
        </div>
      </div>
    </div>
  </section>

  <!-- The Problem Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6" style="color: #061A35;">
          Your reps live in Slack. Your deals live in Salesforce. That's a problem.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <FeatureCard
          icon="clock"
          title="Missed Opportunities"
          description="Hot leads go cold while reps are in meetings. By the time you notice a deal stalled, it's too late."
        />
        <FeatureCard
          icon="refresh-cw"
          title="Context Switching"
          description="Sales reps switch apps 30+ times per day. Every tab switch breaks focus and kills momentum."
        />
        <FeatureCard
          icon="alert-triangle"
          title="Dirty Data"
          description="Stale close dates, missing fields, outdated info. Your forecast is only as good as your data."
        />
      </div>

      <div class="text-center">
        <div class="inline-block px-6 py-3 rounded-lg" style="background-color: rgba(249, 71, 48, 0.1);">
          <p class="text-lg font-semibold" style="color: #FA6854;">
            Sales teams lose <span class="text-2xl font-bold">5+ hours per week</span> to CRM busywork
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Solution Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6" style="color: #061A35;">
          Bring your CRM into your team's command center
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <FeatureCard
          icon="radio"
          title="Live Alerts"
          description="Get instant Slack notifications when deals hit critical stages. Custom triggers. Rich messages. Zero noise."
        >
          <a href="/product/live-alerts" class="font-medium text-sm mt-4 inline-flex items-center gap-1 group" style="color: #F94730;">
            Learn more <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </a>
        </FeatureCard>

        <FeatureCard
          icon="mouse-pointer-click"
          title="One-Click Actions"
          description="Update records, push dates, create tasks - right from Slack. No CRM login required. Ever."
        >
          <a href="/product/actions" class="font-medium text-sm mt-4 inline-flex items-center gap-1 group" style="color: #F94730;">
            Learn more <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </a>
        </FeatureCard>

        <FeatureCard
          icon="sparkles"
          title="Cleaning Rules"
          description="Automated data hygiene that runs on your schedule. Catch problems before they hurt your forecast."
        >
          <a href="/product/cleaning-rules" class="font-medium text-sm mt-4 inline-flex items-center gap-1 group" style="color: #F94730;">
            Learn more <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </a>
        </FeatureCard>
      </div>
    </div>
  </section>

  <!-- Demo Video Section -->
  <section id="demo" class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: #061A35;">
          See it in action
        </h2>
        <p class="text-lg text-gray-700 mb-8">
          From CRM change to action taken in 5 seconds. No context switching. No manual updates.
        </p>

        <!-- Demo video -->
        <div class="aspect-video rounded-xl mb-6 relative overflow-hidden bg-gray-200">
          <iframe
            class="w-full h-full"
            src="https://www.youtube.com/embed/OFJXKzacfwE"
            title="Pyko Demo"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <p class="text-sm text-gray-500">
          Watch how Pyko detects an opportunity stage change in Salesforce, sends an alert to Slack, and lets the rep push the close date forward - all in under 5 seconds.
        </p>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: #061A35;">
          Set it up in minutes. Not months.
        </h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <div class="text-center">
            <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold mx-auto mb-4" style="background-color: #F94730;">
              1
            </div>
            <h3 class="text-xl font-bold mb-2" style="color: #061A35;">Connect</h3>
            <p class="text-gray-700 mb-2">
              Plug in Salesforce or HubSpot + Slack or Teams
            </p>
            <div class="flex items-center justify-center gap-2 mb-2">
              <img src="/images/logos/salesforce.svg" alt="Salesforce" class="h-6 w-6 opacity-70" />
              <img src="/images/logos/hubspot.svg" alt="HubSpot" class="h-6 w-6 opacity-70" />
              <span class="text-gray-400">+</span>
              <img src="/images/logos/slack.svg" alt="Slack" class="h-6 w-6 opacity-70" />
              <img src="/images/logos/teams.svg" alt="Teams" class="h-6 w-6 opacity-70" />
            </div>
            <p class="text-sm font-semibold" style="color: #F94730;">30 seconds</p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold mx-auto mb-4" style="background-color: #F94730;">
              2
            </div>
            <h3 class="text-xl font-bold mb-2" style="color: #061A35;">Configure</h3>
            <p class="text-gray-700 mb-2">
              Choose from templates or build custom rules
            </p>
            <p class="text-sm font-semibold" style="color: #F94730;">5 minutes</p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold mx-auto mb-4" style="background-color: #F94730;">
              3
            </div>
            <h3 class="text-xl font-bold mb-2" style="color: #061A35;">Automate</h3>
            <p class="text-gray-700 mb-2">
              Let Pyko watch 24/7 and alert your team
            </p>
            <p class="text-sm font-semibold" style="color: #F94730;">Ongoing</p>
          </div>
        </div>

        <!-- Template Showcase -->
        <div class="mt-16">
          <h3 class="text-2xl font-bold text-center mb-8" style="color: #061A35;">
            Popular templates to get started instantly
          </h3>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="p-4 rounded-lg border border-gray-200 transition-colors bg-white">
              <h4 class="font-semibold mb-1" style="color: #061A35;">New high-value lead assigned to me</h4>
              <p class="text-sm text-gray-700">Get instant alerts for hot leads</p>
            </div>
            <div class="p-4 rounded-lg border border-gray-200 transition-colors bg-white">
              <h4 class="font-semibold mb-1" style="color: #061A35;">Deal stuck in demo stage for 7+ days</h4>
              <p class="text-sm text-gray-700">Prevent pipeline rot</p>
            </div>
            <div class="p-4 rounded-lg border border-gray-200 transition-colors bg-white">
              <h4 class="font-semibold mb-1" style="color: #061A35;">Close date in the past, deal still open</h4>
              <p class="text-sm text-gray-700">Keep your forecast clean</p>
            </div>
            <div class="p-4 rounded-lg border border-gray-200 transition-colors bg-white">
              <h4 class="font-semibold mb-1" style="color: #061A35;">Deal Closed Won - celebrate!</h4>
              <p class="text-sm text-gray-700">Build team morale</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: #061A35;">
          One platform. Infinite possibilities.
        </h2>
      </div>

      <!-- Featured Use Cases - Large Cards -->
      <div class="grid md:grid-cols-3 gap-8 mb-8">
        <a href="/use-cases/speed-to-lead" class="group block p-8 rounded-2xl border-2 border-gray-200 bg-white transition-all duration-300 hover:border-[#F94730] hover:shadow-xl">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4" style="background: linear-gradient(135deg, rgba(249, 71, 48, 0.15) 0%, rgba(249, 71, 48, 0.05) 100%);">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F94730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-2" style="color: #061A35;">Speed to Lead</h3>
          <p class="text-gray-600 mb-4">New inbound lead? Notify rep in Slack within 60 seconds. Respond 10x faster than competitors.</p>
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold" style="color: #F94730;">10x faster response</span>
            <span class="text-[#F94730] transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </a>

        <a href="/use-cases/data-quality" class="group block p-8 rounded-2xl border-2 border-gray-200 bg-white transition-all duration-300 hover:border-[#F94730] hover:shadow-xl">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4" style="background: linear-gradient(135deg, rgba(249, 71, 48, 0.15) 0%, rgba(249, 71, 48, 0.05) 100%);">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F94730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-2" style="color: #061A35;">Data Quality</h3>
          <p class="text-gray-600 mb-4">Missing next step or close date? Notify rep automatically. Keep your forecast accurate and clean.</p>
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold" style="color: #F94730;">90%+ accuracy</span>
            <span class="text-[#F94730] transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </a>

        <a href="/use-cases/pipeline-management" class="group block p-8 rounded-2xl border-2 border-gray-200 bg-white transition-all duration-300 hover:border-[#F94730] hover:shadow-xl">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4" style="background: linear-gradient(135deg, rgba(249, 71, 48, 0.15) 0%, rgba(249, 71, 48, 0.05) 100%);">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F94730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/><path d="m18 15-2-2"/><path d="m15 18-2-2"/></svg>
          </div>
          <h3 class="text-xl font-bold mb-2" style="color: #061A35;">Pipeline Management</h3>
          <p class="text-gray-600 mb-4">Deals stuck in stage for 14+ days? Alert manager. Prevent pipeline rot before it starts.</p>
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold" style="color: #F94730;">Real-time visibility</span>
            <span class="text-[#F94730] transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </a>
      </div>

      <!-- Secondary Use Cases - Smaller Cards -->
      <div class="grid md:grid-cols-3 gap-4">
        <div class="flex items-center gap-4 p-4 rounded-xl bg-white border border-gray-200">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(249, 71, 48, 0.1);">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F94730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          </div>
          <div>
            <h4 class="font-semibold" style="color: #061A35;">Win/Loss Celebrations</h4>
            <p class="text-sm text-gray-600">Build team morale with deal alerts</p>
          </div>
        </div>

        <div class="flex items-center gap-4 p-4 rounded-xl bg-white border border-gray-200">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(249, 71, 48, 0.1);">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F94730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h4 class="font-semibold" style="color: #061A35;">Territory Routing</h4>
            <p class="text-sm text-gray-600">Route leads to the right rep instantly</p>
          </div>
        </div>

        <div class="flex items-center gap-4 p-4 rounded-xl bg-white border border-gray-200">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(249, 71, 48, 0.1);">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F94730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          </div>
          <div>
            <h4 class="font-semibold" style="color: #061A35;">Renewal Alerts</h4>
            <p class="text-sm text-gray-600">Never miss a renewal conversation</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h3 class="text-3xl md:text-4xl font-bold mb-6" style="color: #061A35;">
          Trusted by revenue teams at...
        </h3>
      </div>

      <!-- Logo Cloud -->
      <div class="flex flex-wrap items-center justify-center gap-12 mb-16 max-w-4xl mx-auto">
        <div class="flex items-center justify-center grayscale hover:grayscale-0 transition-all duration-300 opacity-70 hover:opacity-100">
          <img src="/images/customers/abtasty.png" alt="AB Tasty" class="h-12 w-auto object-contain" />
        </div>
        <div class="flex items-center justify-center grayscale hover:grayscale-0 transition-all duration-300 opacity-70 hover:opacity-100">
          <img src="/images/customers/lifen.svg" alt="Lifen" class="h-12 w-auto object-contain" />
        </div>
        <div class="flex items-center justify-center grayscale hover:grayscale-0 transition-all duration-300 opacity-70 hover:opacity-100">
          <img src="/images/customers/skello.png" alt="Skello" class="h-12 w-auto object-contain" />
        </div>
        <div class="flex items-center justify-center grayscale hover:grayscale-0 transition-all duration-300 opacity-70 hover:opacity-100">
          <img src="/images/customers/sunday.png" alt="Sunday" class="h-12 w-auto object-contain" />
        </div>
      </div>

      <!-- Testimonials -->
      <div class="grid md:grid-cols-3 gap-8">
        <TestimonialCard
          quote="Starting to use Pyko was a game changer for us. We went from confrontational business reviews because we couldn't trust the forecasts to a smooth pipeline"
          author="Alain Hazout"
          role="VP Sales"
          company="Payfit"
          photo="/images/customers/testimonials/payfit/person.jpeg"
          logo="/images/customers/testimonials/payfit/logo.png"
          bgColor="#061A35"
        />
        <TestimonialCard
          quote="Pyko fixes the one issue that I've seen in every single company I worked for : out of date close dates. We also use it for task monitoring and edge cases!"
          author="Robin Iss"
          role="Head Of RevOps"
          company="Sunday"
          photo="/images/customers/testimonials/sunday/person.jpeg"
          logo="/images/customers/testimonials/sunday/logo.png"
          bgColor="#F94730"
          href="/customers/sunday"
        />
        <TestimonialCard
          quote="Having all our alerts, reminders, and data cleaning policies centralized in Slack is very, very helpful. Interacting with users via Slack has completely changed their experience."
          author="Raphael Brousse"
          role="VP of Operations"
          company="Lifen"
          photo="/images/customers/testimonials/lifen/raphael.jpeg"
          logo="/images/customers/testimonials/lifen/logo.jpg"
          bgColor="#061A35"
          href="/customers/lifen"
        />
      </div>
    </div>
  </section>

  <!-- Stats Bar Section -->
  <section class="py-16 bg-gradient-to-r from-navy to-navy-light text-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center mb-12">Results that speak for themselves</h2>
      <div class="grid md:grid-cols-4 gap-8">
        <StatCard
          number="5 hours"
          label="saved per rep per week"
          class="text-white"
        />
        <StatCard
          number="90%+"
          label="close date accuracy improvement"
          class="text-white"
        />
        <StatCard
          number="10x faster"
          label="lead response time"
          class="text-white"
        />
        <StatCard
          number="<5 min"
          label="average setup time per automation"
          class="text-white"
        />
      </div>
    </div>
  </section>

  <!-- Comparison Table Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: #061A35;">
          Why choose Pyko?
        </h2>
        <p class="text-lg text-gray-700">
          See how we compare to native integrations and enterprise platforms
        </p>
      </div>

      <div class="max-w-6xl mx-auto">
        <ComparisonTable />
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <CTASection
    headline="Start seeing your revenue in real-time"
    subheadline="Join 500+ sales teams using Pyko to stay on top of every deal."
    primaryCTA={{ text: "Start Free 14-Day Trial", href: "/trial" }}
    secondaryCTA={{ text: "Schedule a Demo", href: "/demo" }}
    variant="gradient"
  >
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-white/90 mt-6">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>Setup in under 10 minutes</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>No credit card required</span>
      </div>
