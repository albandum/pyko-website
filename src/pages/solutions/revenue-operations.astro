---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout title="Pyko for Revenue Operations" description="Automate data hygiene, scale your impact, and prove ROI. Works with both Salesforce AND HubSpot.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">Stop building alerts from scratch. Move faster as a RevOps team.</h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8">RevOps teams are responsible for CRM data quality and sales productivity - but you can't scale by doing everything manually. Pyko automates the busywork.</p>
        <Button href="/trial" variant="primary" size="lg">Start Free Trial</Button>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6" style="color: #061A35;">
          The RevOps challenge
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <FeatureCard
          icon="alert-triangle"
          title="Data Quality Crisis"
          description="Poor data quality costs businesses $15M annually. Manual audits can't keep up with data decay."
        />
        <FeatureCard
          icon="timer"
          title="Alert Development Hell"
          description="2-3 hours to build each custom Slack alert. Even more time to maintain. And the UX is still bad—no way to update from Slack without custom dev."
        />
        <FeatureCard
          icon="settings"
          title="Tool Sprawl"
          description="RevOps teams manage 10+ sales tools. Building and maintaining custom integrations for each is a huge burden—and it never ends."
        />
        <FeatureCard
          icon="refresh-cw"
          title="Constant Decay"
          description="60% of CRM data decays every year. Without automation, you're always playing catch-up."
        />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">How Pyko helps RevOps</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <FeatureCard icon="sparkles" title="Automated Data Hygiene" description="Scheduled rules that catch data quality issues automatically. No manual audits, no spreadsheets." />
        <FeatureCard icon="check-circle" title="Process Compliance" description="Enforce required fields, next steps, stage progression rules. Real-time alerts when violated." />
        <FeatureCard icon="bar-chart" title="Built-In Analytics" description="Track adoption, measure impact, prove ROI. See what's working and optimize." />
      </div>
    </div>
  </section>

  <CTASection headline="Ready to automate your CRM operations?" primaryCTA={{ text: "Start Free Trial", href: "/trial" }} variant="gradient" />
</MainLayout>
