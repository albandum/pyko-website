---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout title="Pyko for Revenue Operations" description="Automate data hygiene, scale your impact, and prove ROI. Works with both Salesforce AND HubSpot.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">Automate data hygiene. Scale your team's impact.</h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8">RevOps teams are responsible for CRM data quality and sales productivity - but you can't scale by doing everything manually. Pyko automates the busywork.</p>
        <Button href="/trial" variant="primary" size="lg">Start Free Trial</Button>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6" style="color: #061A35;">
          The RevOps challenge
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <FeatureCard
          icon="💰"
          title="Data Quality Crisis"
          description="Poor data quality costs businesses $15M annually. Manual audits can't keep up with data decay."
        />
        <FeatureCard
          icon="🔧"
          title="Tool Sprawl"
          description="RevOps teams manage an average of 10+ sales tools. Each requires different automation approaches."
        />
        <FeatureCard
          icon="📉"
          title="Constant Decay"
          description="60% of CRM data decays every year. Without automation, you're always playing catch-up."
        />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">How Pyko helps RevOps</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <FeatureCard icon="✨" title="Automated Data Hygiene" description="Scheduled rules that catch data quality issues automatically. No manual audits, no spreadsheets." />
        <FeatureCard icon="✅" title="Process Compliance" description="Enforce required fields, next steps, stage progression rules. Real-time alerts when violated." />
        <FeatureCard icon="🔄" title="Multi-CRM Management" description="Manage Salesforce AND HubSpot from one platform. Standardize automations across different CRMs." />
        <FeatureCard icon="📊" title="Built-In Analytics" description="Track adoption, measure impact, prove ROI. See what's working and optimize." />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">The multi-CRM advantage</h2>
      <div class="max-w-4xl mx-auto">
        <div class="p-8 rounded-xl border-2 bg-white" style="border-color: #F94730;">
          <h3 class="text-2xl font-bold mb-4" style="color: #061A35;">One platform for Salesforce AND HubSpot</h3>
          <p class="text-gray-700 mb-4">Many companies have multiple CRM systems:</p>
          <ul class="space-y-2 text-gray-700 mb-6">
            <li>• Different divisions use different CRMs</li>
            <li>• Acquired companies on different platforms</li>
            <li>• Transitioning from one CRM to another</li>
          </ul>
          <div class="bg-gray-50 rounded-lg p-6">
            <h4 class="font-bold mb-3" style="color: #061A35;">Benefits:</h4>
            <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-700">
              <div>✓ Standardize automation logic across CRMs</div>
              <div>✓ One tool to learn, not two</div>
              <div>✓ Unified analytics and reporting</div>
              <div>✓ Easier to manage for RevOps team</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-12 text-center" style="color: #061A35;">What RevOps leaders say</h2>
      <div class="max-w-4xl mx-auto">
        <TestimonialCard
          quote="We have Salesforce AND HubSpot across different divisions. Pyko is the only tool that works with both. It's been a game-changer for standardization."
          author="Priya Patel"
          role="RevOps Lead"
          company="Enterprise Inc"
        />
      </div>
    </div>
  </section>

  <CTASection headline="Ready to automate your CRM operations?" primaryCTA={{ text: "Start Free Trial", href: "/trial" }} variant="gradient" />
</MainLayout>
