---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import CTASection from '../../components/CTASection.astro';
---

<MainLayout title="Pyko for Sales Teams" description="Stop switching tabs. Get CRM alerts in Slack and take action with one click. Focus on selling, not on busywork.">
  <section class="gradient-hero py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">Sell faster. Update less.</h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8">Sales reps spend 5+ hours per week on CRM busywork. Pyko brings your CRM into Slack so you can focus on what matters: closing deals.</p>
        <Button href="/trial" variant="primary" size="lg">Start Free Trial</Button>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6" style="color: #061A35;">
          The sales rep challenge
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <FeatureCard
          icon="pie-chart"
          title="Time Wasted"
          description="Sales reps spend 65% of their time on non-selling activities. Every minute in CRM is a minute not closing deals."
        />
        <FeatureCard
          icon="repeat"
          title="Context Switching"
          description="Average rep switches between 10+ apps per day. App switching kills productivity and focus."
        />
        <FeatureCard
          icon="zap"
          title="Speed Matters"
          description="30-50% of sales go to the vendor who responds first. Minutes matter in the race to respond."
        />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">How Pyko helps sales reps</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <FeatureCard icon="zap" title="Instant Lead Alerts" description="New lead assigned? You know within 60 seconds. Respond 10x faster than competitors." />
        <FeatureCard icon="target" title="One-Click CRM Updates" description="Update close dates, log activities, create tasks - all from Slack. No more 'I'll update it later.'" />
        <FeatureCard icon="bell" title="Never Miss Important Changes" description="Know when deals progress, stall, or need attention. Automated reminders for follow-ups." />
        <FeatureCard icon="clock" title="Less Admin, More Selling" description="Spend time on revenue-generating activities. Let automation handle the busywork." />
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" style="color: #061A35;">Common sales rep workflows</h2>
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <div class="p-6 bg-white rounded-xl border border-gray-200">
          <h3 class="text-xl font-bold mb-3" style="color: #061A35;">🚀 Speed to Lead</h3>
          <p class="text-sm text-gray-700 mb-3"><strong>Trigger:</strong> New inbound lead assigned to me</p>
          <p class="text-sm text-gray-700 mb-3"><strong>Alert:</strong> Slack DM with lead details</p>
          <p class="text-sm text-gray-700"><strong>Action:</strong> "Call Now" button opens dialer, logs activity</p>
        </div>
        <div class="p-6 bg-white rounded-xl border border-gray-200">
          <h3 class="text-xl font-bold mb-3" style="color: #061A35;">📈 Deal Progression</h3>
          <p class="text-sm text-gray-700 mb-3"><strong>Trigger:</strong> My opportunities change stage</p>
          <p class="text-sm text-gray-700 mb-3"><strong>Alert:</strong> Slack notification with details</p>
          <p class="text-sm text-gray-700"><strong>Action:</strong> Update next steps, push close date</p>
        </div>
        <div class="p-6 bg-white rounded-xl border border-gray-200">
          <h3 class="text-xl font-bold mb-3" style="color: #061A35;">🔄 Follow-Up Reminders</h3>
          <p class="text-sm text-gray-700 mb-3"><strong>Trigger:</strong> Lead status "Attempting Contact" 48+ hours</p>
          <p class="text-sm text-gray-700 mb-3"><strong>Alert:</strong> Reminder in Slack</p>
          <p class="text-sm text-gray-700"><strong>Action:</strong> Update status or schedule call</p>
        </div>
        <div class="p-6 bg-white rounded-xl border border-gray-200">
          <h3 class="text-xl font-bold mb-3" style="color: #061A35;">🏆 Win Celebrations</h3>
          <p class="text-sm text-gray-700 mb-3"><strong>Trigger:</strong> My opportunity marked Closed Won</p>
          <p class="text-sm text-gray-700 mb-3"><strong>Alert:</strong> Celebration in team channel</p>
          <p class="text-sm text-gray-700"><strong>Action:</strong> Create renewal task for 11 months out</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection headline="Ready to spend less time on CRM and more time selling?" primaryCTA={{ text: "Start Free Trial", href: "/trial" }} variant="gradient" />
</MainLayout>
