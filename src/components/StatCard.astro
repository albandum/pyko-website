---
interface Props {
  number: string;
  label: string;
  description?: string;
  class?: string;
}

const { number, label, description, class: className = '' } = Astro.props;
---

<div class={`text-center p-6 ${className}`}>
  <div class="text-4xl md:text-5xl lg:text-6xl font-bold text-accent mb-2">
    {number}
  </div>
  <div class="text-lg md:text-xl font-semibold text-navy mb-2">
    {label}
  </div>
  {description && (
    <p class="text-sm text-gray-600">
      {description}
    </p>
  )}
  <slot />
</div>
