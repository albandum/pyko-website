---
interface Props {
  icon?: string;
  title: string;
  description: string;
  class?: string;
}

const { icon, title, description, class: className = '' } = Astro.props;
---

<div class={`p-6 rounded-xl bg-white border border-gray-200 card-shadow-hover transition-all duration-300 ${className}`}>
  {icon && (
    <div class="mb-4">
      <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center text-accent text-2xl">
        {icon}
      </div>
    </div>
  )}
  <h3 class="text-xl font-bold text-navy mb-3">{title}</h3>
  <p class="text-gray-600 leading-relaxed">{description}</p>
  <slot />
</div>
