---
interface Props {
  icon?: string;
  title: string;
  description: string;
  class?: string;
}

const { icon, title, description, class: className = '' } = Astro.props;
---

<div class={`p-6 rounded-xl border border-gray-200 transition-all duration-300 bg-white ${className}`}>
  {icon && (
    <div class="mb-4">
      <div class="w-12 h-12 rounded-lg flex items-center justify-center text-white text-2xl" style="background-color: #F94730;">
        {icon}
      </div>
    </div>
  )}
  <h3 class="text-xl font-bold mb-3" style="color: #061A35;">{title}</h3>
  <p class="text-gray-700 leading-relaxed">{description}</p>
  <slot />
</div>
