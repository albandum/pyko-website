---
interface Props {
  icon?: string;
  title: string;
  description: string;
  class?: string;
}

const { icon, title, description, class: className = '' } = Astro.props;
---

<div class={`p-6 rounded-xl border border-gray-200 transition-all duration-300 bg-white ${className}`}>
  <div class="flex items-center gap-3 mb-3">
    {icon && (
      <div class="w-12 h-12 rounded-full flex items-center justify-center text-2xl" style="background-color: rgba(249, 71, 48, 0.1); border: 2px solid #F94730;">
        {icon}
      </div>
    )}
    <h4 class="text-xl font-bold" style="color: #061A35;">{title}</h4>
  </div>
  <p class="text-gray-700 leading-relaxed">{description}</p>
  <slot />
</div>
