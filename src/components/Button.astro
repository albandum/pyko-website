---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  external?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  class: className = ''
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-semibold rounded-lg transition-all duration-200';

const variantClasses = {
  primary: 'text-white hover:opacity-90',
  secondary: 'text-white hover:opacity-90',
  outline: 'border-2 text-white hover:text-white'
};

const variantStyles = {
  primary: 'background-color: #F94730; color: white;',
  secondary: 'background-color: #0A2342; color: white;',
  outline: 'border-color: #F94730; background-color: transparent; color: white;'
};

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
const style = variantStyles[variant];

const linkProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a href={href} class={classes} style={style} {...linkProps}>
    <slot />
  </a>
) : (
  <button class={classes} style={style}>
    <slot />
  </button>
)}
