---
// HeroMockup - Split-screen comparison showing Without/With Pyko
---

<div class="grid grid-cols-2 gap-6">
  <!-- Without Pyko - Chaotic CRM -->
  <div class="relative">
    <div class="absolute -top-3 left-4 px-3 py-1 rounded-full text-xs font-semibold bg-gray-800/80 text-gray-400 backdrop-blur-sm border border-gray-700">
      Without Pyko
    </div>
    <div class="p-5 rounded-xl border border-gray-700/50 bg-gradient-to-br from-[#0A2342] to-[#061A35] shadow-lg">
      <!-- CRM Header -->
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-700/50">
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-red-500/60"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-green-500/60"></div>
        </div>
        <span class="text-[10px] text-gray-500 ml-2">salesforce.com/opportunities</span>
      </div>

      <!-- Chaotic Content -->
      <div class="space-y-3">
        <!-- Row with warning -->
        <div class="flex items-center gap-2 p-2 rounded bg-red-900/20 border border-red-500/30">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          <div class="flex-1">
            <div class="h-2 w-20 rounded bg-gray-600"></div>
          </div>
          <span class="text-[9px] text-red-400">Overdue</span>
        </div>

        <!-- Regular rows -->
        <div class="flex items-center gap-2 p-2 rounded bg-gray-800/30">
          <div class="w-3 h-3 rounded bg-gray-600"></div>
          <div class="flex-1 space-y-1">
            <div class="h-2 w-16 rounded bg-gray-600"></div>
            <div class="h-1.5 w-24 rounded bg-gray-700"></div>
          </div>
          <div class="h-2 w-10 rounded bg-gray-700"></div>
        </div>

        <div class="flex items-center gap-2 p-2 rounded bg-yellow-900/20 border border-yellow-500/30">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#EAB308" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div class="flex-1">
            <div class="h-2 w-24 rounded bg-gray-600"></div>
          </div>
          <span class="text-[9px] text-yellow-400">Stale</span>
        </div>

        <div class="flex items-center gap-2 p-2 rounded bg-gray-800/30">
          <div class="w-3 h-3 rounded bg-gray-600"></div>
          <div class="flex-1 space-y-1">
            <div class="h-2 w-20 rounded bg-gray-600"></div>
            <div class="h-1.5 w-16 rounded bg-gray-700"></div>
          </div>
          <div class="h-2 w-8 rounded bg-gray-700"></div>
        </div>
      </div>

      <!-- Pain point callout -->
      <div class="mt-4 pt-3 border-t border-gray-700/50">
        <p class="text-[10px] text-gray-500 text-center">Buried in tabs. Missing signals.</p>
      </div>
    </div>
  </div>

  <!-- With Pyko - Clean Slack Alert -->
  <div class="relative">
    <div class="absolute -top-3 left-4 z-10 px-3 py-1 rounded-full text-xs font-semibold bg-[#F94730] text-white shadow-lg shadow-[#F94730]/20">
      With Pyko
    </div>
    <div class="p-5 rounded-xl border-2 border-[#F94730]/50 bg-gradient-to-br from-[#0A2342] to-[#061A35] shadow-lg shadow-[#F94730]/10 relative">
      <!-- Glow effect -->
      <div class="absolute -top-20 -right-20 w-40 h-40 bg-[#F94730]/10 rounded-full blur-3xl"></div>

      <!-- Slack Header -->
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-700/50 relative">
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-red-500/60"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-green-500/60"></div>
        </div>
        <span class="text-[10px] text-gray-400 ml-2">#sales-alerts</span>
        <div class="ml-auto w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
      </div>

      <!-- Slack Message -->
      <div class="relative space-y-3">
        <div class="flex gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#F94730] to-[#D83820] flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-semibold text-white">Pyko</span>
              <span class="text-[9px] text-gray-500">2 sec ago</span>
            </div>
            <div class="p-3 rounded-lg bg-white/5 border border-white/10">
              <p class="text-xs text-gray-300 mb-2">
                <span class="font-semibold text-[#F94730]">Deal Update</span>
              </p>
              <p class="text-sm text-white font-medium mb-1">Acme Corp moved to Negotiation</p>
              <p class="text-[10px] text-gray-400">$125,000 ARR &bull; Close: Dec 15</p>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-2 ml-11">
          <button class="px-3 py-1.5 rounded-md text-xs font-medium bg-[#F94730] text-white shadow-lg shadow-[#F94730]/20 hover:bg-[#D83820] transition-colors">
            Push Date
          </button>
          <button class="px-3 py-1.5 rounded-md text-xs font-medium bg-white/10 text-white border border-white/20 hover:bg-white/20 transition-colors">
            Update
          </button>
          <button class="px-3 py-1.5 rounded-md text-xs font-medium bg-white/10 text-white border border-white/20 hover:bg-white/20 transition-colors">
            View
          </button>
        </div>
      </div>

      <!-- Success callout -->
      <div class="mt-4 pt-3 border-t border-gray-700/50 relative">
        <p class="text-[10px] text-[#F94730] text-center font-medium">Action taken in 5 seconds</p>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 20px rgba(249, 71, 48, 0.2);
    }
    50% {
      box-shadow: 0 0 30px rgba(249, 71, 48, 0.4);
    }
  }
</style>
