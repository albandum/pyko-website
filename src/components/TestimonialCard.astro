---
interface Props {
  quote: string;
  author: string;
  role: string;
  company: string;
  photo?: string;
  logo?: string;
  bgColor?: string;
  class?: string;
}

const { quote, author, role, company, photo, logo, bgColor = '#061A35', class: className = '' } = Astro.props;
---

<div class={`p-8 rounded-xl relative overflow-hidden flex flex-col ${className}`} style={`background-color: ${bgColor};`}>
  <!-- Quote Icon -->
  <div class="mb-4">
    <svg class="w-10 h-10 opacity-30" style="color: white;" fill="currentColor" viewBox="0 0 24 24">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
    </svg>
  </div>

  <!-- Quote -->
  <blockquote class="text-lg text-white mb-8 leading-relaxed flex-grow">
    {quote}
  </blockquote>

  <!-- Author Info with Photos -->
  <div class="flex items-end justify-between mt-auto">
    <div>
      <div class="font-bold text-white text-xl mb-1">{author}</div>
      <div class="text-white/90 text-sm">{role} - {company}</div>
    </div>

    <!-- Photos aligned to right -->
    <div class="flex items-end gap-2 ml-4">
      {photo && (
        <div class="relative">
          <img
            src={photo}
            alt={author}
            class="w-12 h-12 rounded-full object-cover border-2 border-white shadow-lg"
          />
        </div>
      )}
      {logo && (
        <div class="relative">
          <div class="w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-lg p-2">
            <img
              src={logo}
              alt={company}
              class="w-full h-full object-contain"
            />
          </div>
        </div>
      )}
    </div>
  </div>
</div>
