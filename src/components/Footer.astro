---
const currentYear = new Date().getFullYear();
---

<footer class="text-gray-300" style="background-color: #071935;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Column 1: Logo and Tagline -->
      <div class="lg:col-span-2">
        <div class="mb-4">
          <img src="/images/logos/pyko-logo-sm.png" alt="Pyko" class="h-8" />
        </div>
        <p class="text-gray-400 mb-6">Your Revenue Radar</p>
        <p class="text-sm text-gray-400 max-w-md">
          Instant CRM alerts and one-click actions in Slack and Teams. Never miss a deal signal again.
        </p>
      </div>

      <!-- Column 2: Product -->
      <div>
        <h4 class="text-white font-semibold mb-4">Product</h4>
        <ul class="space-y-3">
          <li><a href="/product/live-alerts" class="hover:opacity-80 transition-opacity" style="color: white;">Live Alerts</a></li>
          <li><a href="/product/cleaning-rules" class="hover:opacity-80 transition-opacity" style="color: white;">Cleaning Rules</a></li>
          <li><a href="/product/actions" class="hover:opacity-80 transition-opacity" style="color: white;">Actions</a></li>
          <li><a href="/product/analytics" class="hover:opacity-80 transition-opacity" style="color: white;">Analytics</a></li>
          <li><a href="/pricing" class="hover:opacity-80 transition-opacity" style="color: white;">Pricing</a></li>
        </ul>
      </div>

      <!-- Column 3: Integrations -->
      <div>
        <h4 class="text-white font-semibold mb-4">Integrations</h4>
        <ul class="space-y-3">
          <li><a href="/integrations/salesforce" class="hover:opacity-80 transition-opacity" style="color: white;">Salesforce</a></li>
          <li><a href="/integrations/hubspot" class="hover:opacity-80 transition-opacity" style="color: white;">HubSpot</a></li>
          <li><a href="/integrations/slack" class="hover:opacity-80 transition-opacity" style="color: white;">Slack</a></li>
          <li><a href="/integrations/teams" class="hover:opacity-80 transition-opacity" style="color: white;">Microsoft Teams</a></li>
        </ul>
        <h4 class="text-white font-semibold mb-4 mt-6">Solutions</h4>
        <ul class="space-y-3">
          <li><a href="/solutions/sales-teams" class="hover:opacity-80 transition-opacity" style="color: white;">Sales Teams</a></li>
          <li><a href="/solutions/sales-managers" class="hover:opacity-80 transition-opacity" style="color: white;">Sales Managers</a></li>
          <li><a href="/solutions/revenue-operations" class="hover:opacity-80 transition-opacity" style="color: white;">RevOps</a></li>
        </ul>
      </div>

      <!-- Column 4: Guides -->
      <div>
        <h4 class="text-white font-semibold mb-4">Guides</h4>
        <ul class="space-y-3">
          <li><a href="/guides/salesforce-lead-notifications-slack" class="hover:opacity-80 transition-opacity" style="color: white;">Salesforce to Slack</a></li>
          <li><a href="/guides/salesforce-microsoft-teams-integration" class="hover:opacity-80 transition-opacity" style="color: white;">Salesforce to Teams</a></li>
          <li><a href="/guides/hubspot-slack-integration-sales" class="hover:opacity-80 transition-opacity" style="color: white;">HubSpot to Slack</a></li>
          <li><a href="/guides/hubspot-microsoft-teams-integration" class="hover:opacity-80 transition-opacity" style="color: white;">HubSpot to Teams</a></li>
          <li><a href="/guides/real-time-deal-alerts-salesforce" class="hover:opacity-80 transition-opacity" style="color: white;">Real-Time Deal Alerts</a></li>
          <li><a href="/guides/update-salesforce-from-slack" class="hover:opacity-80 transition-opacity" style="color: white;">Update CRM from Slack</a></li>
          <li><a href="/guides/troops-alternative" class="hover:opacity-80 transition-opacity" style="color: white;">Troops Alternatives</a></li>
          <li><a href="/guides/rattle-alternative" class="hover:opacity-80 transition-opacity" style="color: white;">Rattle Alternatives</a></li>
          <li><a href="/guides/crm-data-quality-revops" class="hover:opacity-80 transition-opacity" style="color: white;">CRM Data Quality</a></li>
        </ul>
        <h4 class="text-white font-semibold mb-4 mt-6">Company</h4>
        <ul class="space-y-3">
          <li><a href="/about" class="hover:opacity-80 transition-opacity" style="color: white;">About</a></li>
          <li><a href="/contact" class="hover:opacity-80 transition-opacity" style="color: white;">Contact</a></li>
          <li><a href="/customers" class="hover:opacity-80 transition-opacity" style="color: white;">Customers</a></li>
          <li><a href="/privacy" class="hover:opacity-80 transition-opacity" style="color: white;">Privacy</a></li>
          <li><a href="/terms" class="hover:opacity-80 transition-opacity" style="color: white;">Terms</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-700 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-gray-400">
          © {currentYear} Pyko. All rights reserved.
        </p>
        <div class="flex items-center space-x-6">
          <a href="https://www.linkedin.com/company/pyko/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity" style="color: white;" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
