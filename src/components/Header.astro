---
import Button from './Button.astro';
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 md:h-20">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-2">
          <div class="w-10 h-10 bg-accent rounded-lg flex items-center justify-center text-white font-bold text-xl">
            P
          </div>
          <span class="text-xl font-bold text-navy">Pyko</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-8">
        <!-- Product Dropdown -->
        <div class="relative group">
          <button class="flex items-center space-x-1 text-gray-700 hover:text-navy font-medium">
            <span>Product</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-64 bg-white rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-gray-100">
            <div class="py-2">
              <a href="/product/live-alerts" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50">
                <div class="font-semibold text-navy">Live Alerts</div>
                <div class="text-xs text-gray-500">Real-time CRM notifications</div>
              </a>
              <a href="/product/cleaning-rules" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50">
                <div class="font-semibold text-navy">Cleaning Rules</div>
                <div class="text-xs text-gray-500">Automated data hygiene</div>
              </a>
              <a href="/product/actions" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50">
                <div class="font-semibold text-navy">Actions & Workflows</div>
                <div class="text-xs text-gray-500">One-click CRM updates</div>
              </a>
              <a href="/product/analytics" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50">
                <div class="font-semibold text-navy">Analytics</div>
                <div class="text-xs text-gray-500">Track performance & ROI</div>
              </a>
            </div>
          </div>
        </div>

        <!-- Integrations Dropdown -->
        <div class="relative group">
          <button class="flex items-center space-x-1 text-gray-700 hover:text-navy font-medium">
            <span>Integrations</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-56 bg-white rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-gray-100">
            <div class="py-2">
              <a href="/integrations/salesforce" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <span class="font-medium">Salesforce</span>
              </a>
              <a href="/integrations/hubspot" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <span class="font-medium">HubSpot</span>
              </a>
              <div class="border-t border-gray-100 my-2"></div>
              <a href="/integrations/slack" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <span class="font-medium">Slack</span>
              </a>
              <a href="/integrations/teams" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <span class="font-medium">Microsoft Teams</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Solutions Dropdown -->
        <div class="relative group">
          <button class="flex items-center space-x-1 text-gray-700 hover:text-navy font-medium">
            <span>Solutions</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-56 bg-white rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-gray-100">
            <div class="py-2">
              <a href="/solutions/sales-teams" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <span class="font-medium">For Sales Teams</span>
              </a>
              <a href="/solutions/sales-managers" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <span class="font-medium">For Sales Managers</span>
              </a>
              <a href="/solutions/revenue-operations" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                <span class="font-medium">For RevOps</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Regular Links -->
        <a href="/pricing" class="text-gray-700 hover:text-navy font-medium">Pricing</a>
        <a href="/templates" class="text-gray-700 hover:text-navy font-medium">Templates</a>
        <a href="/docs" class="text-gray-700 hover:text-navy font-medium">Docs</a>
        <a href="/blog" class="text-gray-700 hover:text-navy font-medium">Blog</a>
      </div>

      <!-- CTA Buttons -->
      <div class="hidden lg:flex items-center space-x-4">
        <a href="/login" class="text-gray-700 hover:text-navy font-medium">Login</a>
        <Button href="/trial" variant="primary" size="md">
          Start Free Trial
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden">
        <button id="mobile-menu-button" class="text-gray-700 hover:text-navy p-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu (hidden by default) -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 bg-white">
    <div class="container mx-auto px-4 py-4 space-y-4">
      <!-- Product Links -->
      <div>
        <div class="font-semibold text-navy mb-2">Product</div>
        <div class="space-y-2 pl-4">
          <a href="/product/live-alerts" class="block text-gray-700 hover:text-accent">Live Alerts</a>
          <a href="/product/cleaning-rules" class="block text-gray-700 hover:text-accent">Cleaning Rules</a>
          <a href="/product/actions" class="block text-gray-700 hover:text-accent">Actions & Workflows</a>
          <a href="/product/analytics" class="block text-gray-700 hover:text-accent">Analytics</a>
        </div>
      </div>

      <!-- Integrations Links -->
      <div>
        <div class="font-semibold text-navy mb-2">Integrations</div>
        <div class="space-y-2 pl-4">
          <a href="/integrations/salesforce" class="block text-gray-700 hover:text-accent">Salesforce</a>
          <a href="/integrations/hubspot" class="block text-gray-700 hover:text-accent">HubSpot</a>
          <a href="/integrations/slack" class="block text-gray-700 hover:text-accent">Slack</a>
          <a href="/integrations/teams" class="block text-gray-700 hover:text-accent">Microsoft Teams</a>
        </div>
      </div>

      <!-- Solutions Links -->
      <div>
        <div class="font-semibold text-navy mb-2">Solutions</div>
        <div class="space-y-2 pl-4">
          <a href="/solutions/sales-teams" class="block text-gray-700 hover:text-accent">For Sales Teams</a>
          <a href="/solutions/sales-managers" class="block text-gray-700 hover:text-accent">For Sales Managers</a>
          <a href="/solutions/revenue-operations" class="block text-gray-700 hover:text-accent">For RevOps</a>
        </div>
      </div>

      <!-- Other Links -->
      <div class="space-y-2">
        <a href="/pricing" class="block text-gray-700 hover:text-accent font-medium">Pricing</a>
        <a href="/templates" class="block text-gray-700 hover:text-accent font-medium">Templates</a>
        <a href="/docs" class="block text-gray-700 hover:text-accent font-medium">Docs</a>
        <a href="/blog" class="block text-gray-700 hover:text-accent font-medium">Blog</a>
      </div>

      <!-- Mobile CTAs -->
      <div class="pt-4 space-y-3">
        <a href="/login" class="block text-center py-2 text-gray-700 hover:text-accent font-medium">
          Login
        </a>
        <Button href="/trial" variant="primary" size="md" class="w-full">
          Start Free Trial
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
