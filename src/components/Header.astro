---
import Button from './Button.astro';
---

<header class="sticky top-0 z-50 border-b border-gray-800" style="background-color: #071935;">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 md:h-20">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center">
          <img src="/images/logos/pyko-logo-sm.png" alt="Pyko" class="h-8 md:h-10" />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-8">
        <!-- Product Dropdown -->
        <div class="relative group">
          <button class="flex items-center space-x-1 hover:opacity-80 transition-opacity font-medium" style="color: white;">
            <span>Product</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-64 rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-gray-700" style="background-color: #0A2342;">
            <div class="py-2">
              <a href="/product/live-alerts" class="block px-4 py-3 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <div class="font-semibold">Live Alerts</div>
                <div class="text-xs text-gray-400">Real-time CRM notifications</div>
              </a>
              <a href="/product/cleaning-rules" class="block px-4 py-3 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <div class="font-semibold">Cleaning Rules</div>
                <div class="text-xs text-gray-400">Automated data hygiene</div>
              </a>
              <a href="/product/actions" class="block px-4 py-3 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <div class="font-semibold">Actions & Workflows</div>
                <div class="text-xs text-gray-400">One-click CRM updates</div>
              </a>
              <a href="/product/analytics" class="block px-4 py-3 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <div class="font-semibold">Analytics</div>
                <div class="text-xs text-gray-400">Track performance & ROI</div>
              </a>
            </div>
          </div>
        </div>

        <!-- Integrations Dropdown -->
        <div class="relative group">
          <button class="flex items-center space-x-1 hover:opacity-80 transition-opacity font-medium" style="color: white;">
            <span>Integrations</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-56 rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-gray-700" style="background-color: #0A2342;">
            <div class="py-2">
              <a href="/integrations/salesforce" class="block px-4 py-2 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <span class="font-medium">Salesforce</span>
              </a>
              <a href="/integrations/hubspot" class="block px-4 py-2 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <span class="font-medium">HubSpot</span>
              </a>
              <div class="border-t border-gray-700 my-2"></div>
              <a href="/integrations/slack" class="block px-4 py-2 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <span class="font-medium">Slack</span>
              </a>
              <a href="/integrations/teams" class="block px-4 py-2 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <span class="font-medium">Microsoft Teams</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Solutions Dropdown -->
        <div class="relative group">
          <button class="flex items-center space-x-1 hover:opacity-80 transition-opacity font-medium" style="color: white;">
            <span>Solutions</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-56 rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 border border-gray-700" style="background-color: #0A2342;">
            <div class="py-2">
              <a href="/solutions/sales-teams" class="block px-4 py-2 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <span class="font-medium">For Sales Teams</span>
              </a>
              <a href="/solutions/sales-managers" class="block px-4 py-2 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <span class="font-medium">For Sales Managers</span>
              </a>
              <a href="/solutions/revenue-operations" class="block px-4 py-2 text-sm transition-colors" style="color: white;" onmouseover="this.style.backgroundColor='rgba(249, 71, 48, 0.1)'" onmouseout="this.style.backgroundColor='transparent'">
                <span class="font-medium">For RevOps</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Regular Links -->
        <a href="/customers" class="hover:opacity-80 transition-opacity font-medium" style="color: white;">Customers</a>
        <a href="/pricing" class="hover:opacity-80 transition-opacity font-medium" style="color: white;">Pricing</a>
      </div>

      <!-- CTA Buttons -->
      <div class="hidden lg:flex items-center space-x-4">
        <a href="/login" class="font-medium hover:opacity-80 transition-opacity" style="color: #F94730;">Login</a>
        <Button href="/trial" variant="primary" size="md">
          Start Free Trial
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden">
        <button id="mobile-menu-button" class="text-white hover:text-gray-300 p-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu (hidden by default) -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-800" style="background-color: #0A2342;">
    <div class="container mx-auto px-4 py-4 space-y-4">
      <!-- Product Links -->
      <div>
        <div class="font-semibold text-white mb-2">Product</div>
        <div class="space-y-2 pl-4">
          <a href="/product/live-alerts" class="block text-gray-300 hover:text-white">Live Alerts</a>
          <a href="/product/cleaning-rules" class="block text-gray-300 hover:text-white">Cleaning Rules</a>
          <a href="/product/actions" class="block text-gray-300 hover:text-white">Actions & Workflows</a>
          <a href="/product/analytics" class="block text-gray-300 hover:text-white">Analytics</a>
        </div>
      </div>

      <!-- Integrations Links -->
      <div>
        <div class="font-semibold text-white mb-2">Integrations</div>
        <div class="space-y-2 pl-4">
          <a href="/integrations/salesforce" class="block text-gray-300 hover:text-white">Salesforce</a>
          <a href="/integrations/hubspot" class="block text-gray-300 hover:text-white">HubSpot</a>
          <a href="/integrations/slack" class="block text-gray-300 hover:text-white">Slack</a>
          <a href="/integrations/teams" class="block text-gray-300 hover:text-white">Microsoft Teams</a>
        </div>
      </div>

      <!-- Solutions Links -->
      <div>
        <div class="font-semibold text-white mb-2">Solutions</div>
        <div class="space-y-2 pl-4">
          <a href="/solutions/sales-teams" class="block text-gray-300 hover:text-white">For Sales Teams</a>
          <a href="/solutions/sales-managers" class="block text-gray-300 hover:text-white">For Sales Managers</a>
          <a href="/solutions/revenue-operations" class="block text-gray-300 hover:text-white">For RevOps</a>
        </div>
      </div>

      <!-- Other Links -->
      <div class="space-y-2">
        <a href="/customers" class="block text-gray-300 hover:text-white font-medium">Customers</a>
        <a href="/pricing" class="block text-gray-300 hover:text-white font-medium">Pricing</a>
      </div>

      <!-- Mobile CTAs -->
      <div class="pt-4 space-y-3">
        <a href="/login" class="block text-center py-2 font-medium hover:opacity-80 transition-opacity" style="color: #F94730;">
          Login
        </a>
        <Button href="/trial" variant="primary" size="md" class="w-full">
          Start Free Trial
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
